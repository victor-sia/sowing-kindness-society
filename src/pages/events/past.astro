---
import BaseLayout from '../../layouts/BaseLayout.astro';

const HERO = '/events/community-carnival/hero.webp';
const GROUPS = [
  { src: '/events/community-carnival/group-1.webp', alt: 'SKS volunteers holding kindness signs in front of the Loving Heart banner' },
  { src: '/events/community-carnival/group-2.webp', alt: 'SKS team under the Loving Heart Community Day arch' },
];
const VOLUNTEERS = [
  { src: '/events/community-carnival/volunteer-1.webp', alt: 'Volunteer at the Tou Hu game booth with participants' },
  { src: '/events/community-carnival/volunteer-2.webp', alt: 'Volunteer explaining the Falling Bottles game' },
  { src: '/events/community-carnival/volunteer-3.webp', alt: 'Volunteer at the Tou Hu booth helping a participant aim' },
  { src: '/events/community-carnival/volunteer-4.webp', alt: 'Volunteer at the Loving Heart Community Day activity booth' },
];
const PROPS = [
  { src: '/events/community-carnival/prop-1.webp', alt: '"Kindness in action" holographic heart prop' },
  { src: '/events/community-carnival/prop-2.webp', alt: '"Community fun, community love" prop' },
  { src: '/events/community-carnival/prop-3.webp', alt: '"A little love, a lot of joy" bilingual prop' },
  { src: '/events/community-carnival/prop-4.webp', alt: '"Kindness is contagious — catch it here!" prop' },
  { src: '/events/community-carnival/prop-5.webp', alt: '"Made with love, played with joy" prop' },
  { src: '/events/community-carnival/prop-6.webp', alt: '"Sowing Kindness / 播种善意" flower prop' },
  { src: '/events/community-carnival/prop-7.webp', alt: '"Games, giggles & good vibes" prop' },
  { src: '/events/community-carnival/prop-8.webp', alt: '"Small acts, big hearts" glitter heart prop' },
];
---
<BaseLayout title="Past Events | Sowing Kindness Society" description="A record of Sowing Kindness Society events — community gatherings, family days and kindness initiatives across Singapore.">

<style>
  .past-grid-2 { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-bottom:36px }
  .past-grid-4 { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:12px; margin-bottom:40px }
  .past-grid-props { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:12px }
  .past-thumb { border-radius:14px; overflow:hidden; position:relative }
  .past-thumb img { width:100%; height:100%; object-fit:cover; display:block }
  .past-thumb--hero { aspect-ratio:16/9 }
  .past-thumb--group { aspect-ratio:3/2 }
  .past-thumb--vol   { aspect-ratio:4/3 }
  .past-thumb--prop  { aspect-ratio:3/4 }
  .section-label { font:700 12px var(--sans); color:var(--forest-800); letter-spacing:.08em; text-transform:uppercase; margin-bottom:16px }
  @media(max-width:600px){
    .past-grid-2 { grid-template-columns:1fr }
    .past-grid-props { grid-template-columns:repeat(2,1fr) }
  }
</style>

<section class="page-header">
  <div class="container">
    <div class="page-header__crumbs"><span>Events</span><span class="dot"></span><span>Past Events</span></div>
    <h1 style="font:700 clamp(36px,5.5vw,72px)/1.06 var(--serif);letter-spacing:-.02em;margin:0 0 14px">
      <span style="color:var(--ink-900)">Kindness in </span><span style="color:var(--forest-800)">action.</span>
    </h1>
    <p style="font:400 18px/1.6 var(--sans);color:var(--ink-700);max-width:580px;margin:0">
      A look back at where we've shown up — spreading kindness, one community at a time.
    </p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="container">

    <!-- Event header -->
    <div style="display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:32px">
      <div style="flex-shrink:0;width:56px;height:56px;border-radius:16px;background:var(--orange-100);display:flex;align-items:center;justify-content:center">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--orange-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </div>
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px">
          <span style="display:inline-block;padding:3px 12px;border-radius:999px;background:var(--sage-100);font:600 12px var(--sans);color:var(--forest-800);letter-spacing:.05em;text-transform:uppercase">Community</span>
          <span style="font:500 13px var(--sans);color:var(--ink-400)">15 – 16 August 2026</span>
        </div>
        <h2 style="font:700 clamp(24px,3.5vw,42px)/1.15 var(--serif);color:var(--ink-900);margin:0 0 8px">Community Carnival</h2>
        <p style="font:400 16px/1.6 var(--sans);color:var(--ink-600);margin:0 0 6px;max-width:640px">
          Organised by <strong>Loving Heart</strong>, in partnership with Active Ageing Centre and SG Cares Volunteer Centre @ Jurong East.
        </p>
        <p style="font:500 14px var(--sans);color:var(--ink-500);margin:0">
          312A Pavilion, Jurong East St 32 &nbsp;·&nbsp; 9.00 AM – 5.30 PM
        </p>
      </div>
    </div>

    <!-- Hero -->
    <div class="past-thumb past-thumb--hero" style="margin-bottom:20px">
      <img src={HERO} alt="SKS volunteers and guests at the Loving Heart Community Carnival Tou Hu booth" loading="eager" />
    </div>

    <!-- Group shots -->
    <div class="past-grid-2">
      {GROUPS.map(p => (
        <div class="past-thumb past-thumb--group">
          <img src={p.src} alt={p.alt} loading="lazy" />
        </div>
      ))}
    </div>

    <!-- Description -->
    <div style="max-width:720px;margin-bottom:40px">
      <p style="font:400 17px/1.75 var(--sans);color:var(--ink-700);margin:0 0 14px">
        Sowing Kindness Society was proud to participate in the Loving Heart Community Carnival — a heartland celebration bringing senior care, vibrant activities, and health services right into the Jurong East community.
      </p>
      <p style="font:400 17px/1.75 var(--sans);color:var(--ink-700);margin:0 0 14px">
        Our team showed up as volunteers — ushering guests, running game booths, and spreading warmth as Roaming Hype Ambassadors. It was kindness in action across two full days, with games like Tou Hu and Falling Bottles bringing smiles to seniors and families alike.
      </p>
      <p style="font:400 17px/1.75 var(--sans);color:var(--ink-700);margin:0">
        Special guests included <strong>Minister Grace Fu Hai Yien</strong> and <strong>Mr Xie Yao Quan</strong>. A wonderful reminder that small acts of service ripple far beyond what we can see.
      </p>
    </div>

    <!-- Volunteers -->
    <div style="margin-bottom:40px">
      <div class="section-label">Volunteers in action</div>
      <div class="past-grid-4">
        {VOLUNTEERS.map(p => (
          <div class="past-thumb past-thumb--vol">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <!-- Props -->
    <div>
      <div class="section-label">Kindness props we made</div>
      <div class="past-grid-props">
        {PROPS.map(p => (
          <div class="past-thumb past-thumb--prop">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- CTA -->
<section class="section section--cream-deep" style="padding-top:64px;padding-bottom:80px;text-align:center">
  <div class="container" style="max-width:560px;margin:0 auto">
    <h2 style="font:700 clamp(24px,3.5vw,42px)/1.1 var(--serif);margin:0 0 14px">
      <span style="color:var(--ink-900)">More kindness is </span><span style="color:var(--forest-800)">on the way.</span>
    </h2>
    <p style="font:500 17px var(--sans);color:var(--ink-700);margin:0 0 24px">
      Our storytelling competition is open. Help us grow the next chapter of kindness in Singapore.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/events/upcoming/" class="btn btn-primary">Upcoming Events <span class="chev">›</span></a>
      <a href="/submit/" class="btn btn-outline">Submit a Story</a>
    </div>
  </div>
</section>

</BaseLayout>
