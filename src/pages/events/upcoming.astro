---
import BaseLayout from '../../layouts/BaseLayout.astro';
const EVENTS = [
  { featured:true, tag:'Competition', date:'20 Sep 2026', time:'11.59 PM — submission deadline', title:'Storytelling Competition 2026', body:"Our annual bilingual storytelling competition for children aged 3 to 6. Share a story from the heart — in English or Chinese — and inspire others with kindness.", img:'/illustrations/storytellers-mic.webp',
    gcal:'https://calendar.google.com/calendar/render?action=TEMPLATE&text=Storytelling+Competition+2026+%E2%80%94+Submission+Deadline&dates=20260920T235900/20260921T000000&details=Last+day+to+upload+your+storytelling+video.+Submit+at+sowingkindness.org.sg%2Fsubmit%2F&location=sowingkindness.org.sg',
    outlook:'https://outlook.live.com/calendar/0/deeplink/compose?subject=Storytelling+Competition+2026+%E2%80%94+Submission+Deadline&startdt=2026-09-20T23:59:00&enddt=2026-09-21T00:00:00&body=Last+day+to+upload+your+storytelling+video.+Submit+at+sowingkindness.org.sg%2Fsubmit%2F&location=sowingkindness.org.sg',
    yahoo:'https://calendar.yahoo.com/?v=60&title=Storytelling+Competition+2026+%E2%80%94+Submission+Deadline&st=20260920T235900&et=20260921T000000&desc=Last+day+to+upload+your+storytelling+video.',
    ical:'/calendar/storytelling-competition-2026.ics' },
  { tag:'Family', date:'21 Jun 2026', time:'All day', location:'Community booth', title:"Father's Day Celebration", body:"Art & craft activities where children create heartfelt keepsakes for the dads and father-figures they love.",
    gcal:"https://calendar.google.com/calendar/render?action=TEMPLATE&text=Father%27s+Day+Celebration+%E2%80%94+Sowing+Kindness+Society&dates=20260621/20260622&details=Art+%26+craft+activities+where+children+create+heartfelt+keepsakes+for+the+dads+and+father-figures+they+love.&location=Community+booth",
    outlook:"https://outlook.live.com/calendar/0/deeplink/compose?subject=Father%27s+Day+Celebration+%E2%80%94+Sowing+Kindness+Society&startdt=2026-06-21&enddt=2026-06-22&body=Art+%26+craft+activities+where+children+create+heartfelt+keepsakes.&location=Community+booth",
    yahoo:"https://calendar.yahoo.com/?v=60&title=Father%27s+Day+Celebration+%E2%80%94+Sowing+Kindness+Society&st=20260621&et=20260622&desc=Art+%26+craft+activities+where+children+create+heartfelt+keepsakes.",
    ical:'/calendar/fathers-day-2026.ics' },
  { tag:'Family', date:'25 Sep 2026', time:'Evening', location:'To be confirmed', title:'Mid-Autumn Festival', body:'Lantern-making activities for the whole family, celebrating togetherness, light and the warmth of community.',
    gcal:'https://calendar.google.com/calendar/render?action=TEMPLATE&text=Mid-Autumn+Festival+%E2%80%94+Sowing+Kindness+Society&dates=20260925T190000/20260925T210000&details=Lantern-making+activities+for+the+whole+family%2C+celebrating+togetherness%2C+light+and+the+warmth+of+community.',
    outlook:'https://outlook.live.com/calendar/0/deeplink/compose?subject=Mid-Autumn+Festival+%E2%80%94+Sowing+Kindness+Society&startdt=2026-09-25T19:00:00&enddt=2026-09-25T21:00:00&body=Lantern-making+activities+for+the+whole+family.&location=To+be+confirmed',
    yahoo:'https://calendar.yahoo.com/?v=60&title=Mid-Autumn+Festival+%E2%80%94+Sowing+Kindness+Society&st=20260925T190000&et=20260925T210000&desc=Lantern-making+activities+for+the+whole+family.',
    ical:'/calendar/mid-autumn-2026.ics' },
  { tag:'Family', date:'Early Dec 2026', time:'Date to be confirmed', title:'Christmas Programme', body:"Fill 'gift boxes' with kindness promises and decorate paper ornaments for our community Christmas tree.",
    gcal:null, outlook:null, yahoo:null, ical:null },
];
---
<BaseLayout title="Upcoming Events | Sowing Kindness Society" description="Family storytimes, school programmes, community days and the annual competition — gentle moments to take part in throughout the year.">

<section class="page-header">
  <div class="container">
    <div class="page-header__crumbs"><span>Events</span><span class="dot"></span><span>Upcoming</span></div>
    <h1 style="font:700 clamp(36px,5.5vw,72px)/1.06 var(--serif);letter-spacing:-.02em;margin:0 0 16px">
      <span style="color:var(--ink-900)">Join us — there's </span><span style="color:var(--forest-800)">always </span><span style="color:var(--orange-500)">something growing.</span>
    </h1>
    <p style="font:400 18px/1.6 var(--sans);color:var(--ink-700);max-width:620px;margin:0">Family storytimes, school programmes, community days and the annual competition — gentle moments to take part in throughout the year.</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="container">
    <div style="display:grid;gap:24px" data-stagger>
      {EVENTS.map(e => (
        <div class={`card ${e.img ? 'event-card-grid' : ''}`} style={`overflow:hidden;display:grid;grid-template-columns:${e.img ? '1.3fr 1fr' : '1fr'}`}>
          {e.img && (
            <div style="position:relative;min-height:280px">
              <img src={e.img} alt={e.title} style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
              <span class="pill pill--paper" style="position:absolute;left:16px;top:16px">{e.tag}</span>
              {e.featured && <span style="position:absolute;left:16px;bottom:16px;padding:8px 14px;border-radius:999px;background:var(--orange-600);color:#fff;font:700 12px var(--sans);letter-spacing:.06em;text-transform:uppercase">Flagship event</span>}
            </div>
          )}
          <div style={`padding:${e.featured ? '32px 28px' : '24px 26px 28px'}`}>
            {!e.img && <span class="pill pill--sage" style="margin-bottom:14px;display:inline-flex">{e.tag}</span>}
            <div style="display:flex;align-items:center;gap:12px;color:var(--forest-800);margin-bottom:12px;flex-wrap:wrap;font:600 14px var(--sans)">
              <span>{e.date}</span>
              {e.time && <span style="color:var(--ink-500)">{e.time}</span>}
              {e.location && <span style="color:var(--ink-500)">{e.location}</span>}
            </div>
            <div style={`font:700 ${e.featured ? 30 : 22}px/1.25 var(--serif);color:var(--ink-900);margin-bottom:10px`}>{e.title}</div>
            <div class="heart-divider" style="margin-bottom:14px"><span class="line" style="width:20px"></span><span style="color:var(--heart)">♥</span><span class="line" style="width:20px"></span></div>
            <p style={`font:400 ${e.featured ? 16 : 15}px/1.65 var(--sans);color:var(--ink-700);margin:0 0 18px`}>{e.body}</p>

            <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
              <a href="/submit/" class="btn btn-secondary">Register <span class="chev">›</span></a>
            </div>

            {e.gcal ? (
              <div>
                <div style="font:600 11px/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-400);margin-bottom:8px">Add to calendar</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">

                  {/* Google Calendar */}
                  <a href={e.gcal} target="_blank" rel="noopener"
                    style="display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:8px;border:1.5px solid #e2e8f0;background:#fff;font:600 12px var(--sans);color:var(--ink-700);text-decoration:none;transition:border-color .15s,box-shadow .15s"
                    onmouseover="this.style.borderColor='#4285F4';this.style.boxShadow='0 2px 8px rgba(66,133,244,.15)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#4285F4" stroke-width="1.8" stroke-linecap="round"/>
                      <circle cx="8.5" cy="14.5" r="1" fill="#34A853"/>
                      <circle cx="12" cy="14.5" r="1" fill="#EA4335"/>
                      <circle cx="15.5" cy="14.5" r="1" fill="#FBBC05"/>
                    </svg>
                    Google
                  </a>

                  {/* Apple Calendar */}
                  <a href={e.ical} download
                    style="display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:8px;border:1.5px solid #e2e8f0;background:#fff;font:600 12px var(--sans);color:var(--ink-700);text-decoration:none;transition:border-color .15s,box-shadow .15s"
                    onmouseover="this.style.borderColor='#555';this.style.boxShadow='0 2px 8px rgba(0,0,0,.1)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#555" stroke-width="1.8" stroke-linecap="round"/>
                      <path d="M12 13v3M10.5 14.5l1.5-1.5 1.5 1.5" stroke="#555" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Apple
                  </a>

                  {/* Outlook */}
                  <a href={e.outlook} target="_blank" rel="noopener"
                    style="display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:8px;border:1.5px solid #e2e8f0;background:#fff;font:600 12px var(--sans);color:var(--ink-700);text-decoration:none;transition:border-color .15s,box-shadow .15s"
                    onmouseover="this.style.borderColor='#0078D4';this.style.boxShadow='0 2px 8px rgba(0,120,212,.15)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#0078D4" stroke-width="1.8" stroke-linecap="round"/>
                      <rect x="8" y="12" width="8" height="5" rx="1" fill="#0078D4" opacity=".3"/>
                      <rect x="8" y="12" width="8" height="2" rx=".5" fill="#0078D4"/>
                    </svg>
                    Outlook
                  </a>

                  {/* Yahoo Calendar */}
                  <a href={e.yahoo} target="_blank" rel="noopener"
                    style="display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:8px;border:1.5px solid #e2e8f0;background:#fff;font:600 12px var(--sans);color:var(--ink-700);text-decoration:none;transition:border-color .15s,box-shadow .15s"
                    onmouseover="this.style.borderColor='#6001D2';this.style.boxShadow='0 2px 8px rgba(96,1,210,.15)'" onmouseout="this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#6001D2" stroke-width="1.8" stroke-linecap="round"/>
                      <text x="12" y="19" font-size="7" font-weight="900" fill="#6001D2" text-anchor="middle" font-family="sans-serif">Y!</text>
                    </svg>
                    Yahoo
                  </a>

                </div>
              </div>
            ) : (
              <span style="font:500 13px var(--sans);color:var(--ink-400)">Date to be confirmed</span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

</BaseLayout>
