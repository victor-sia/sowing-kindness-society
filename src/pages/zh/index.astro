---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="播种善意协会 — 2026年讲故事比赛" description="面向3至6岁儿童的双语讲故事比赛，播撒善意，静待花开。">

<!-- ── HERO ── -->
<section id="hero" style="padding:48px 0 0;position:relative;overflow:hidden">
  <div class="container">
    <div class="grid-2col" style="gap:40px">
      <div>
        <h1 id="hero-heading" style="font:700 clamp(38px,5vw,64px)/1.06 var(--serif);letter-spacing:-.02em;margin:0">
          <span class="word" style="color:var(--ink-900);display:inline-block">启发</span>{' '}
          <span class="word" style="color:var(--orange-500);display:inline-block">年幼的</span><br/>
          <span class="word" style="color:var(--ink-900);display:inline-block">故事讲述者</span><br/>
          <span class="word" style="color:var(--forest-800);display:inline-block">播撒善意</span>
        </h1>
        <div id="hero-sub" style="display:flex;align-items:center;gap:12px;margin:20px 0 20px">
          <span style="width:28px;height:1.5px;background:var(--sage-500);display:inline-block;flex-shrink:0"></span>
          <span style="font:600 15px var(--sans);color:var(--forest-800)">2026年讲故事比赛</span>
          <span style="width:28px;height:1.5px;background:var(--sage-500);display:inline-block;flex-shrink:0"></span>
        </div>
        <p id="hero-body" style="font:400 16px/1.6 var(--sans);color:var(--ink-700);max-width:480px;margin-bottom:28px">
          面向3至6岁儿童的双语讲故事比赛。用心分享一个故事，以善意启发他人。
        </p>
        <div id="hero-btns" style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:32px">
          <a href="/zh/competition/" class="btn btn-secondary">了解比赛 <span class="chev">›</span></a>
          <a href="/zh/submit/" class="btn btn-primary">提交视频 <span class="chev">›</span></a>
        </div>
        <div id="hero-tagline" style="display:flex;align-items:center;gap:12px" class="hide-mobile">
          <img src="/logo/sks-logomark.webp" alt="" width="44" height="44" style="height:44px;width:auto;flex-shrink:0" />
          <div style="font:700 19px/1.3 var(--serif);color:var(--forest-800)">播撒善意，静待花开</div>
        </div>
      </div>

      <div id="hero-img" style="position:relative;min-height:460px">
        <span class="float-heart" style="top:40px;left:80px;font-size:18px">♥</span>
        <span class="float-heart" style="top:80px;left:160px;font-size:14px;animation-delay:1s">♥</span>
        <span class="float-seed"  style="top:60px;right:60px;font-size:18px">✻</span>
        <div style="position:absolute;top:-60px;right:-40px;width:130%;aspect-ratio:1302/1208;-webkit-mask-image:url(/illustrations/hero-blob-mask.svg);mask-image:url(/illustrations/hero-blob-mask.svg);-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat" id="hero-blob">
          <img src="/illustrations/storytellers-mic-sm.webp" alt="年幼的故事讲述者" style="width:100%;height:100%;object-fit:cover;display:block" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </div>

    <!-- Stats bar -->
    <div id="stats-bar" style="margin-top:28px;padding-bottom:64px;position:relative;z-index:10">
      <div class="card card--quiet stats-bar">
        <div class="stat-item">
          <span class="stat-icon" style="background:linear-gradient(135deg,var(--fern-600) 55%,var(--orange-500) 55%);color:#fff;font:700 11px var(--sans)">A文</span>
          <div><div class="stat-label" style="color:var(--forest-800)">英语 & 中文</div><div class="stat-sub">双语</div></div>
        </div>
        <div class="stat-item">
          <span class="stat-icon" style="background:var(--sage-200)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--forest-800)" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 3a4 4 0 100 8 4 4 0 000-8z"/></svg>
          </span>
          <div><div class="stat-label" style="color:var(--forest-800)">3至6岁</div><div class="stat-sub">故事讲述者</div></div>
        </div>
        <div class="stat-item">
          <span class="stat-icon" style="background:var(--sage-200)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--forest-800)" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </span>
          <div><div class="stat-label" style="color:var(--forest-800)">2026年9月20日</div><div class="stat-sub">截止日期</div></div>
        </div>
        <div class="stat-item">
          <span class="stat-icon" style="background:var(--orange-100)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--orange-600)" stroke-width="2" stroke-linecap="round"><path d="M6 9H4.5a2.5 2.5 0 010-5H6M18 9h1.5a2.5 2.5 0 000-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0012 0V2z"/></svg>
          </span>
          <div><div class="stat-label" style="color:var(--orange-600)">2026年11月</div><div class="stat-sub">总决赛</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── ABOUT ── -->
<section class="section section--cream">
  <div class="container grid-2col" data-stagger>
    <div data-fade>
      <h2 style="font:700 clamp(32px,4.8vw,64px)/1.08 var(--serif);letter-spacing:-.015em;margin:0">
        <span style="color:var(--ink-900)">关于</span><br/>
        <span style="color:var(--forest-800)">播种善意</span><br/>
        <span style="color:var(--orange-500)">协会</span>
      </h2>
      <div style="display:flex;align-items:center;gap:10px;margin:18px 0 16px">
        <span style="font:600 17px var(--serif);color:var(--fern-600)">在儿童、家庭和社区中播种善意。</span>
        <span style="color:var(--heart)">♥</span>
      </div>
      <p style="font:400 16px/1.7 var(--sans);color:var(--ink-700);margin-bottom:24px;max-width:460px">
        播种善意协会由一群相信善意可以在最年幼的孩子心中生长的父母、教育工作者和讲故事者共同创立——一个时刻、一个故事、一个行动，一次又一次。
      </p>
      <a href="/zh/about/" class="btn btn-primary">了解更多 <span class="chev">›</span></a>
    </div>
    <div data-fade class="hide-mobile" style="position:relative;width:120%;margin-left:-10%;aspect-ratio:1045/941;-webkit-mask-image:url(/illustrations/section-2-blob-mask.svg);mask-image:url(/illustrations/section-2-blob-mask.svg);-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat">
      <img src="/illustrations/section-2-about.webp" alt="" style="width:100%;height:100%;object-fit:cover" loading="lazy" />
    </div>
  </div>
</section>

<!-- ── MVV ── -->
<section class="section section--cream" style="position:relative;overflow:hidden">
  <svg style="position:absolute;top:0;left:0;opacity:.35;pointer-events:none" width="160" height="180" viewBox="0 0 160 180" fill="none">
    <path d="M20 160 C20 100 80 60 140 20" stroke="#8FBE6C" stroke-width="1.5" fill="none"/>
    {[[60,90],[40,110],[80,70],[100,50],[120,35]].map(([x,y]) => (
      <ellipse cx={x} cy={y} rx="14" ry="8" fill="#8FBE6C" opacity=".5" transform={`rotate(${-30+x/3} ${x} ${y})`}/>
    ))}
  </svg>
  <svg style="position:absolute;bottom:0;right:0;opacity:.3;pointer-events:none;transform:scaleX(-1)" width="160" height="180" viewBox="0 0 160 180" fill="none">
    <path d="M20 160 C20 100 80 60 140 20" stroke="#8FBE6C" stroke-width="1.5" fill="none"/>
    {[[60,90],[40,110],[80,70],[100,50],[120,35]].map(([x,y]) => (
      <ellipse cx={x} cy={y} rx="14" ry="8" fill="#8FBE6C" opacity=".5" transform={`rotate(${-30+x/3} ${x} ${y})`}/>
    ))}
  </svg>

  <div class="container" style="position:relative;z-index:1">
    <div style="text-align:center;margin-bottom:52px">
      <div data-fade style="font:600 18px var(--serif);color:var(--fern-600);margin-bottom:10px">指引我们一切工作的核心</div>
      <h2 data-fade style="font:700 clamp(28px,4.5vw,60px)/1.1 var(--serif);margin:0 0 12px">
        <span style="color:var(--ink-900)">我们的</span>{' '}
        <span style="color:var(--orange-500)">使命、</span>{' '}
        <span style="color:var(--forest-800)">愿景</span>{' '}<span style="color:var(--ink-900)">与</span>{' '}<span style="color:var(--orange-500)">价值观</span>
      </h2>
      <div class="heart-divider" style="justify-content:center" data-fade>
        <span class="line" style="width:60px"></span><span style="color:var(--heart)">♥</span><span class="line" style="width:60px"></span>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 416px;gap:36px;align-items:center">
      <div class="grid-3col" style="gap:14px" data-stagger>
        {[
          { title:'使命', img:'/images/Mission.webp', body:'通过故事、课程与社区，在孩子和家庭中培育善意与积极的品格。' },
          { title:'愿景', img:'/images/Vision.webp',  body:'一个更善良的社会，让同理心在日常生活中生长——在家里、学校、巴士上、操场上。' },
          { title:'价值观', img:'/images/Values.webp', body:'善意、同理心、成长与社区——每一个项目核心的四粒种子。' },
        ].map(c => (
          <div class="card" style="padding:24px 14px 20px;text-align:center;background:var(--paper)">
            <div style="width:140px;height:140px;border-radius:999px;margin:0 auto 16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.10)">
              <img src={c.img} alt={c.title} style="width:100%;height:100%;object-fit:cover" loading="lazy" />
            </div>
            <div style="font:700 22px var(--serif);color:var(--forest-800);margin-bottom:6px">{c.title}</div>
            <span style="color:var(--heart);font-size:16px">♥</span>
            <p style="font:400 13px/1.65 var(--sans);color:var(--ink-700);margin-top:10px;margin-bottom:0">{c.body}</p>
          </div>
        ))}
      </div>
      <div data-fade class="hide-tablet" style="width:416px;flex-shrink:0;aspect-ratio:577/530;-webkit-mask-image:url(/images/section-3-blob-mask-custom.svg);mask-image:url(/images/section-3-blob-mask-custom.svg);-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat">
        <img src="/images/Section%203%20image.png" alt="孩子们浇灌善意之树" style="width:100%;height:100%;object-fit:contain;display:block" loading="lazy" />
      </div>
    </div>
    <div data-fade style="margin-top:36px;display:flex;justify-content:center">
      <div class="card card--quiet" style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:999px;max-width:100%">
        <span style="color:var(--fern-600)">🌱</span>
        <span style="font:500 13px/1.4 var(--sans);color:var(--ink-700)">
          让我们一起<strong style="color:var(--fern-600)">播撒善意</strong>，静待它<strong style="color:var(--fern-600)">生长。</strong>
        </span>
        <span style="color:var(--heart)">♥</span>
      </div>
    </div>
  </div>
</section>

<!-- ── WHAT WE DO ── -->
<section class="section section--cream">
  <div class="container">
    <div class="grid-2-1" style="margin-bottom:40px">
      <div data-fade>
        <h2 style="font:700 clamp(28px,5vw,64px)/1.1 var(--serif);margin:0 0 12px">
          <span style="color:var(--ink-900)">我们</span><span style="color:var(--orange-500)">做什么</span>
        </h2>
        <div class="heart-divider" style="margin-bottom:12px"><span class="line"></span><span style="color:var(--heart)">♥</span><span class="line"></span></div>
        <p style="font:500 17px var(--sans);color:var(--ink-700);margin:0">让善意生长的有意义项目。</p>
      </div>
      <div data-fade class="blob-img-wrap" style="position:relative;width:120%;margin-left:-10%;aspect-ratio:1605/684;-webkit-mask-image:url(/illustrations/section-4-blob-mask.svg);mask-image:url(/illustrations/section-4-blob-mask.svg);-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat">
        <img src="/illustrations/section-4-community-sm.webp" alt="" style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
      </div>
    </div>
    <div class="grid-4col" data-stagger>
      {[
        { bg:'var(--sage-200)',   color:'var(--forest-800)', title:'儿童善意项目', body:'适龄课程，培养同理心和日常善意行为。' },
        { bg:'var(--orange-100)', color:'var(--orange-600)', title:'讲故事、艺术与手工', body:'通过故事、艺术和想象，孩子表达内心、建立联结。' },
        { bg:'var(--orange-100)', color:'var(--orange-600)', title:'社区外展', body:'通过服务行动、包容与同理心走进社区。' },
        { bg:'var(--sage-200)',   color:'var(--forest-800)', title:'学校合作', body:'与学校携手，共同建立善意文化。', highlight:true },
      ].map(p => (
        <div class="card" style={`padding:20px;background:${p.highlight ? 'var(--sage-50)' : 'var(--paper)'}`}>
          <span style={`display:inline-flex;width:44px;height:44px;border-radius:999px;background:${p.bg};color:${p.color};align-items:center;justify-content:center;margin-bottom:14px`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          </span>
          <div style={`font:600 17px/1.3 var(--serif);color:${p.color};margin-bottom:8px`}>{p.title}</div>
          <p style="font:400 13px/1.55 var(--sans);color:var(--ink-700);margin:0">{p.body}</p>
        </div>
      ))}
    </div>
    <div style="text-align:center;margin-top:36px" data-fade>
      <a href="/zh/events/upcoming/" class="btn btn-primary">探索即将举行的活动 <span class="chev">›</span></a>
    </div>
  </div>
</section>

<!-- ── STORIES TEASER ── -->
<section class="section" style="overflow:hidden;position:relative">
  <span class="float-heart" style="top:60px;left:14%;font-size:14px">♥</span>
  <span class="float-seed"  style="top:80px;right:12%;font-size:14px;animation-delay:1s">✻</span>
  <div class="container" style="text-align:center">
    <img data-fade src="/logo/sks-logo-transparent-sm.webp" alt="" width="110" height="110" style="height:110px;width:auto;margin:0 auto 12px" loading="lazy" />
    <h2 data-fade style="font:700 clamp(28px,4.5vw,60px)/1.1 var(--serif);margin:0">
      <span style="color:var(--ink-900)">精选</span><span style="color:var(--orange-500)">善意</span>{' '}<span style="color:var(--ink-900)">故事</span>
    </h2>
    <p data-fade style="font:500 16px var(--sans);color:var(--ink-500);margin:10px 0 36px">为家庭带来的灵感、思考与温情故事。</p>
    <div class="grid-3col gap-24" data-stagger>
      {[
        { slug:'how-storytelling-helps-children-learn-kindness', tag:'文章', img:'/illustrations/section-5-image-1.webp', title:'讲故事如何帮助孩子学习善意', body:'了解故事如何激发同理心，帮助孩子认识世界。' },
        { slug:'five-small-kindness-activities-for-your-saturday', tag:'亲子', img:'/illustrations/section-5-image-2.webp', title:'周六的五个小善意活动', body:'在家培养善意的简单、有意义的想法。' },
        { slug:'growing-compassion-through-everyday-moments', tag:'启发', img:'/illustrations/section-5-image-3.webp', title:'在日常点滴中培养同理心', body:'小小的行为，深远的影响——日常时刻如何培育善良的孩子。', play:true },
      ].map(s => (
        <a href={`/zh/stories/${s.slug}/`} style="display:block;text-decoration:none;color:inherit">
          <div class="card" style="overflow:hidden">
            <div style="position:relative;height:200px">
              <img src={s.img} alt={s.title} style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
              <span class="pill pill--paper" style="position:absolute;left:14px;bottom:12px">{s.tag}</span>
              {s.play && <span style="position:absolute;right:14px;top:14px;width:34px;height:34px;border-radius:999px;background:rgba(255,255,255,.92);display:inline-flex;align-items:center;justify-content:center;color:var(--forest-800)"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg></span>}
            </div>
            <div style="padding:20px 22px 24px">
              <div style="font:600 20px/1.3 var(--serif);color:var(--ink-900);margin-bottom:10px">{s.title}</div>
              <p style="font:400 14px/1.6 var(--sans);color:var(--ink-700);margin:0">{s.body}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div style="margin-top:40px" data-fade>
      <a href="/zh/stories/" class="btn btn-primary">查看所有故事 <span class="chev">›</span></a>
    </div>
  </div>
</section>

<!-- ── WATCH TEASER ── -->
<section class="section section--cream">
  <div class="container grid-1-15">
    <div data-fade>
      <div class="eyebrow"><span class="eyebrow__num">6</span><span class="eyebrow__label">在GanjingWorld观看</span></div>
      <h2 style="font:700 clamp(28px,4.8vw,64px)/1.05 var(--serif);margin:18px 0 14px">
        <span style="color:var(--ink-900)">温暖人心的</span><br/><span style="color:var(--forest-800)">善意</span><br/><span style="color:var(--orange-500)">故事</span>
      </h2>
      <p style="font:400 15px/1.65 var(--sans);color:var(--ink-700);max-width:400px;margin-bottom:22px">在我们的官方频道发现温暖人心的故事。无广告，适合家庭观看。</p>
      <a href="/zh/watch/" class="btn btn-secondary">在GanjingWorld观看 <span class="chev">›</span></a>
    </div>
    <div class="grid-2col-sm" data-stagger>
      {[
        { href:'https://www.ganjingworld.com/video/1ia1t1d4ree7wM4nzoEMtbywH1tp1c', img:'https://image1-ap-japan.cloudokyo.cloud/image/v3/6a/96/b2/6a96b2af-9920-4522-ae99-a6307771ad1c/1280.webp', title:'狮子与老鼠的友谊', body:'温暖动人的动画歌曲，重述善意友谊的经典故事。' },
        { href:'https://www.ganjingworld.com/video/1ii0isdhvq42ypAN5bs9Fs9sp1of1c', img:'https://image1-ap-japan.cloudokyo.cloud/image/v14/b2/45/af/b245af9b-1785-4520-a705-6627c1d75254/1280.webp', title:'被遗忘的秋千', body:'两个孩子注意到了一位孤独的老人——微小的关爱改变了一个人的生命。' },
        { href:'https://www.ganjingworld.com/video/1g859k3l56b7kIcVYNot1b5rg1v91c', img:'https://image4-us-west.cloudokyo.cloud/image/v1/1d/0c/64/1d0c64c1-bab7-438b-99d5-c74ea8f2842b/1280.webp', title:'当我心怀善意时', body:'关于善意是什么感觉的温柔绘本朗读。' },
        { href:'https://www.ganjingworld.com/video/1icvovrk7pd6F44gZOc2jvmiO1mf1c', img:'https://image1-us-east.cloudokyo.cloud/image/v14/50/32/90/5032906e-26c4-4954-821b-285b18538e0c/1280.webp', title:'善人与梅树', body:'一个关于诚信、礼义与善良的中国传统故事。' },
      ].map(v => (
        <a href={v.href} target="_blank" rel="noopener" class="card" style="padding:12px;text-align:center;display:block;color:inherit;text-decoration:none">
          <div style="position:relative;border-radius:14px;overflow:hidden;margin-bottom:12px;height:160px">
            <img src={v.img} alt={v.title} style="width:100%;height:100%;object-fit:cover" loading="lazy" />
            <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center">
              <span style="width:44px;height:44px;border-radius:999px;background:rgba(255,255,255,.92);display:inline-flex;align-items:center;justify-content:center;color:var(--forest-800)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </span>
            </span>
          </div>
