---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="联系我们 | 播种善意协会" description="与播种善意协会联系——如有问题、合作意向或想分享一个小善意，欢迎发消息给我们。">

<section class="page-header">
  <div class="container">
    <div class="page-header__crumbs"><span>联系</span><span class="dot"></span><span>与我们联系</span></div>
    <h1 style="font:700 clamp(36px,5.5vw,72px)/1.06 var(--serif);letter-spacing:-.02em;margin:0 0 14px">
      <span style="color:var(--ink-900)">我们很乐意</span><span style="color:var(--forest-800)">聆听</span><span style="color:var(--orange-500)">您的声音。</span>
    </h1>
    <p style="font:400 18px/1.6 var(--sans);color:var(--ink-700);max-width:620px;margin:0 0 14px">有问题、想法或合作意向？发消息给我们——我们将在三个工作日内回复。</p>
    <div style="display:flex;align-items:center;gap:10px">
      <span style="width:32px;height:1.5px;background:var(--sage-500);display:inline-block"></span>
      <span style="font:600 16px var(--serif);color:var(--fern-600)">让我们一起播撒善意。</span>
      <span style="color:var(--heart)">♥</span>
    </div>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="container grid-asym">

    <!-- Contact info -->
    <div>
      <div class="card" style="padding:8px 22px 16px;margin-bottom:20px;overflow:hidden">
        {[
          { icon:'M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z', label:'地址', value:'播种善意协会', sub:'新加坡（社区空间——需预约）' },
          { icon:'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', label:'电邮', value:'contact@sowingkindness.org.sg', sub:'一般查询——联系我们最快捷的方式。' },
          { icon:'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064', label:'网站', value:'www.sowingkindness.org.sg', sub:undefined },
        ].map((r, i) => (
          <div style={`display:flex;align-items:flex-start;gap:14px;padding:16px 4px;border-bottom:${i<2 ? '1px solid rgba(31,77,31,.08)' : 'none'}`}>
            <span style="width:40px;height:40px;border-radius:999px;background:var(--sage-200);color:var(--forest-800);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d={r.icon}/></svg>
            </span>
            <div style="min-width:0;overflow:hidden">
              <div style="font:600 12px var(--sans);color:var(--ink-500);letter-spacing:.06em;text-transform:uppercase;margin-bottom:3px">{r.label}</div>
              <div style="font:500 14px var(--sans);color:var(--ink-900);word-break:break-all">{r.value}</div>
              {r.sub && <div style="font:400 12px var(--sans);color:var(--ink-500);margin-top:2px">{r.sub}</div>}
            </div>
          </div>
        ))}
      </div>

      <div style="margin-bottom:18px">
        <div style="font:700 13px var(--sans);color:var(--forest-800);letter-spacing:.06em;text-transform:uppercase;margin-bottom:12px">关注我们</div>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px">

          <a href="https://wa.me/6586782384" target="_blank" rel="noopener" class="social-card">
            <span class="social-card__icon" style="background:#e8f5e9;color:#128C7E">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            </span>
            <div class="social-card__text">
              <div class="social-card__name">WhatsApp</div>
              <div class="social-card__handle">加入我们的社群</div>
            </div>
          </a>

          <a href="https://www.facebook.com/sowingkindness.org.sg" target="_blank" rel="noopener" class="social-card">
            <span class="social-card__icon" style="background:#e8f0fb;color:#1877F2">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </span>
            <div class="social-card__text">
              <div class="social-card__name">Facebook</div>
              <div class="social-card__handle">sowingkindness.org.sg</div>
            </div>
          </a>

          <a href="https://instagram.com/sowingkindness.org.sg" target="_blank" rel="noopener" class="social-card">
            <span class="social-card__icon" style="background:#fce8f5;color:#C13584">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </span>
            <div class="social-card__text">
              <div class="social-card__name">Instagram</div>
              <div class="social-card__handle">sowingkindness.org.sg</div>
            </div>
          </a>

          <a href="https://x.com/sowingkindnessorgsg" target="_blank" rel="noopener" class="social-card">
            <span class="social-card__icon" style="background:#f0f0f0;color:#000">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.629 5.905-5.629Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </span>
            <div class="social-card__text">
              <div class="social-card__name">X</div>
              <div class="social-card__handle">sowingkindnessorgsg</div>
            </div>
          </a>

          <a href="https://www.ganjingworld.com/@sowingkindness" target="_blank" rel="noopener" class="social-card">
            <span class="social-card__icon" style="background:#e4f0fe;color:#0487fb">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="19" height="19">
                <path fill="currentColor" d="M397.06,262.26l.23-65.14,50.78.03-.2,66.12c-2.79,104.84-89.38,183.47-191.71,183.52-104.47.05-189.18-80.28-192.52-184.83-3.44-107.65,81.44-198.07,191.11-196.98l61.46.04-.03,50.62-64.82.04c-74.99.05-134.08,60.85-136.89,133.95-3.1,80.91,59.25,145.52,139.71,146.46,75.45.88,140.58-55.8,142.88-133.84Z"/>
                <path fill="currentColor" d="M196.1,247.77c-2.21,18.45,2.55,35.41,14.5,48.65,11.57,12.82,27.47,18.48,45.44,18.8,31.9.57,59.07-22.64,60.2-55.3l-.15-12.26-60.8-.04-.07-50.63,111.96.02-.17,63.62c-1.48,60.97-51.63,105.37-110.9,105.46-64.83.1-116.66-52.54-110.86-118.59l50.85.28Z"/>
                <polygon fill="currentColor" points="421.74 131.15 381.39 171.51 340.91 131.32 381.37 91.05 421.74 131.15"/>
              </svg>
            </span>
            <div class="social-card__text">
              <div class="social-card__name">GanjingWorld</div>
              <div class="social-card__handle">@sowingkindness</div>
            </div>
          </a>

          <a href="https://linkedin.com/company/sowingkindness-org-sg" target="_blank" rel="noopener" class="social-card">
            <span class="social-card__icon" style="background:#e4eef8;color:#0A66C2">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </span>
            <div class="social-card__text">
              <div class="social-card__name">LinkedIn</div>
              <div class="social-card__handle">sowingkindness-org-sg</div>
            </div>
          </a>

        </div>
      </div>

<style>
  .social-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--paper, #fff);
    border: 1px solid rgba(0,0,0,.06);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 4px rgba(0,0,0,.04);
    transition: transform 130ms ease, box-shadow 130ms ease;
    overflow: hidden;
    min-width: 0;
  }
  .social-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0,0,0,.09);
  }
  .social-card__icon {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .social-card__text { min-width: 0; overflow: hidden; }
  .social-card__name {
    font: 700 13px var(--sans);
    color: var(--forest-800);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .social-card__handle {
    font: 400 11px var(--sans);
    color: var(--ink-500);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

      <div class="card card--quiet" style="padding:18px 22px;background:var(--sage-50)">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--forest-800)" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div style="font:700 15px var(--sans);color:var(--forest-800)">回复时间</div>
        </div>
        <p style="font:400 14px/1.6 var(--sans);color:var(--ink-700);margin:0">我们亲自阅读每一条消息——没有机器人，没有自动回复。大多数消息会在3个工作日内收到我们的个人回复。</p>
      </div>
    </div>

    <!-- Form -->
    <div class="card" style="padding:32px">
      <h2 style="font:700 28px var(--serif);color:var(--forest-800);margin:0 0 6px">发消息给我们</h2>
      <div class="heart-divider" style="margin-bottom:16px"><span class="line"></span><span style="color:var(--heart)">♥</span><span class="line"></span></div>
      <p style="font:400 14px var(--sans);color:var(--ink-500);margin:0 0 20px">告诉我们越多，我们越能更好地帮助您。</p>
      <form id="contact-form" style="display:grid;gap:14px">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <label style="display:block"><span class="field-label">您的姓名</span><input class="field-input" type="text" placeholder="例：陈美玲" required /></label>
          <label style="display:block"><span class="field-label">电邮</span><input class="field-input" type="email" placeholder="you@email.com" required /></label>
        </div>
        <label style="display:block">
          <span class="field-label">主题是什么？</span>
          <select class="field-input">
            <option>一般查询</option>
            <option>比赛问题</option>
            <option>合作 / 赞助</option>
            <option>学校项目</option>
            <option>志愿服务</option>
            <option>媒体 &amp; 新闻</option>
          </select>
        </label>
        <label style="display:block"><span class="field-label">您的留言</span><textarea class="field-input" rows="4" placeholder="告诉我们一点我们能如何帮助您……" required></textarea></label>
        <label style="display:flex;align-items:flex-start;gap:12px;padding:12px;border-radius:12px;background:var(--cream-100);cursor:pointer">
          <input type="checkbox" checked style="margin-top:4px;flex-shrink:0" />
          <span style="font:400 14px/1.5 var(--sans);color:var(--ink-700)">订阅我们的温馨月刊——每月一封，故事满满。</span>
        </label>
        <div>
          <button type="submit" class="btn btn-primary" style="width:100%">发送消息 <span class="chev">›</span></button>
          <p style="font:400 13px var(--sans);color:var(--ink-500);text-align:center;margin:10px 0 0">我们不会分享您的任何信息。</p>
        </div>
      </form>
    </div>
  </div>
</section>

</BaseLayout>
<script>
document.getElementById('contact-form')?.addEventListener('submit', (e) => {
  e.preventDefault();
  alert('谢谢您！您的消息已发送。我们将在3个工作日内回复。');
});
</script>
