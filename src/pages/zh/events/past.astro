---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const HERO = '/events/community-carnival/hero.webp';
const GROUPS = [
  { src: '/events/community-carnival/group-1.webp', alt: '播种善意义工在"爱心"横幅前合影，手持善意标语' },
  { src: '/events/community-carnival/group-2.webp', alt: '播种善意团队在爱心社区嘉年华拱门下合影' },
];
const VOLUNTEERS = [
  { src: '/events/community-carnival/volunteer-1.webp', alt: '义工在投壶游戏摊位协助参与者' },
  { src: '/events/community-carnival/volunteer-2.webp', alt: '义工向访客讲解落瓶游戏玩法' },
  { src: '/events/community-carnival/volunteer-3.webp', alt: '义工协助参与者瞄准投壶' },
  { src: '/events/community-carnival/volunteer-4.webp', alt: '义工在爱心社区日活动摊位服务' },
];
const PROPS = [
  { src: '/events/community-carnival/prop-1.webp', alt: '"善行在行动"全息爱心道具' },
  { src: '/events/community-carnival/prop-2.webp', alt: '"社区同乐，社区同爱"道具' },
  { src: '/events/community-carnival/prop-3.webp', alt: '"一点爱心，满满快乐"双语道具' },
  { src: '/events/community-carnival/prop-4.webp', alt: '"善意会传染——就在这里感染它！"道具' },
  { src: '/events/community-carnival/prop-5.webp', alt: '"一用心制作，游玩尽兴"道具' },
  { src: '/events/community-carnival/prop-6.webp', alt: '"播种善意"花朵道具' },
  { src: '/events/community-carnival/prop-7.webp', alt: '"Games, giggles & good vibes"道具' },
  { src: '/events/community-carnival/prop-8.webp', alt: '"Small acts, big hearts"闪亮爱心道具' },
];
---
<BaseLayout title="往届活动 | 播种善意协会" description="播种善意协会活动记录——新加坡各地的社区聚会、家庭日和善意项目。">

<style>
  .past-grid-2 { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-bottom:36px }
  .past-grid-4 { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:12px; margin-bottom:40px }
  .past-grid-props { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:12px }
  .past-thumb { border-radius:14px; overflow:hidden; position:relative }
  .past-thumb img { width:100%; height:100%; object-fit:cover; display:block }
  .past-thumb--hero { aspect-ratio:16/9 }
  .past-thumb--group { aspect-ratio:3/2 }
  .past-thumb--vol   { aspect-ratio:4/3 }
  .past-thumb--prop  { aspect-ratio:3/4; }
  .past-thumb--prop img { object-position: center top; }
  .section-label { font:700 12px var(--sans); color:var(--forest-800); letter-spacing:.08em; text-transform:uppercase; margin-bottom:16px }
  @media(max-width:600px){
    .past-grid-2 { grid-template-columns:1fr }
    .past-grid-props { grid-template-columns:repeat(2,1fr) }
  }
</style>

<section class="page-header">
  <div class="container">
    <div class="page-header__crumbs"><span>活动</span><span class="dot"></span><span>往届活动</span></div>
    <h1 style="font:700 clamp(36px,5.5vw,72px)/1.06 var(--serif);letter-spacing:-.02em;margin:0 0 14px">
      <span style="color:var(--ink-900)">善意，</span><span style="color:var(--forest-800)">付诸行动。</span>
    </h1>
    <p style="font:400 18px/1.6 var(--sans);color:var(--ink-700);max-width:580px;margin:0">
      回顾我们走过的每一个社区——一次一个善举，散播温暖。
    </p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="container">

    <!-- Event header -->
    <div style="display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:32px">
      <div style="flex-shrink:0;width:56px;height:56px;border-radius:16px;background:var(--orange-100);display:flex;align-items:center;justify-content:center">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--orange-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </div>
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px">
          <span style="display:inline-block;padding:3px 12px;border-radius:999px;background:var(--sage-100);font:600 12px var(--sans);color:var(--forest-800);letter-spacing:.05em;text-transform:uppercase">社区</span>
          <span style="font:500 13px var(--sans);color:var(--ink-400)">2026年8月15日至16日</span>
        </div>
        <h2 style="font:700 clamp(24px,3.5vw,42px)/1.15 var(--serif);color:var(--ink-900);margin:0 0 8px">社区嘉年华</h2>
        <p style="font:400 16px/1.6 var(--sans);color:var(--ink-600);margin:0 0 6px;max-width:640px">
          由<strong>爱心</strong>主办，联合活跃乐龄中心及裕廊东SG Cares志愿者服务中心。
        </p>
        <p style="font:500 14px var(--sans);color:var(--ink-500);margin:0">
          裕廊东街32号312A凉亭 &nbsp;·&nbsp; 上午9时至下午5时30分
        </p>
      </div>
    </div>

    <!-- Hero -->
    <div class="past-thumb past-thumb--hero" style="margin-bottom:20px">
      <img src={HERO} alt="播种善意义工与嘉宾在爱心社区嘉年华投壶摊位合影" loading="eager" />
    </div>

    <!-- Group shots -->
    <div class="past-grid-2">
      {GROUPS.map(p => (
        <div class="past-thumb past-thumb--group">
          <img src={p.src} alt={p.alt} loading="lazy" />
        </div>
      ))}
    </div>

    <!-- Description -->
    <div style="max-width:720px;margin-bottom:40px">
      <p style="font:400 17px/1.75 var(--sans);color:var(--ink-700);margin:0 0 14px">
        播种善意协会荣幸参与爱心社区嘉年华——这是一场专为裕廊东社区居民而设的草根庆典，融合乐龄关怀、精彩活动与健康服务，温暖一方。
      </p>
      <p style="font:400 17px/1.75 var(--sans);color:var(--ink-700);margin:0 0 14px">
        我们的团队以义工身份出席——引领宾客、主持游戏摊位，以及担任巡游活力大使，用热情与笑容传播善意。连续两天，投壶与落瓶等游戏为乐龄人士和家庭送上欢笑与温情。
      </p>
      <p style="font:400 17px/1.75 var(--sans);color:var(--ink-700);margin:0">
        贵宾包括<strong>傅海燕部长</strong>与<strong>谢耀权先生</strong>的莅临。这深深提醒我们——每一个微小的善举，都能在看不见的地方激起涟漪。
      </p>
    </div>

    <!-- Volunteers -->
    <div style="margin-bottom:40px">
      <div class="section-label">义工服务现场</div>
      <div class="past-grid-4">
        {VOLUNTEERS.map(p => (
          <div class="past-thumb past-thumb--vol">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <!-- Props -->
    <div>
      <div class="section-label">我们亲手制作的善意道具</div>
      <div class="past-grid-props">
        {PROPS.map(p => (
          <div class="past-thumb past-thumb--prop">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<!-- CTA -->
<section class="section section--cream-deep" style="padding-top:64px;padding-bottom:80px;text-align:center">
  <div class="container" style="max-width:560px;margin:0 auto">
    <h2 style="font:700 clamp(24px,3.5vw,42px)/1.1 var(--serif);margin:0 0 14px">
      <span style="color:var(--ink-900)">更多善意活动，</span><span style="color:var(--forest-800)">即将到来。</span>
    </h2>
    <p style="font:500 17px var(--sans);color:var(--ink-700);margin:0 0 24px">
      我们的儿童故事大赛正在进行中。一起为新加坡的善意故事，写下新的篇章。
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/zh/events/upcoming/" class="btn btn-primary">即将举行的活动 <span class="chev">›</span></a>
      <a href="/zh/submit/" class="btn btn-outline">提交故事</a>
    </div>
  </div>
</section>

</BaseLayout>
