---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const EVENTS = [
  { featured:true, tag:'比赛', date:'2026年9月20日', time:'晚11时59分——提交截止', title:'2026年讲故事比赛', body:'我们一年一度的双语讲故事比赛，面向3至6岁的儿童。用心分享一个故事——用英语或华语——以善意启发他人。', img:'/illustrations/storytellers-mic-sm.webp',
    gcal:'https://calendar.google.com/calendar/render?action=TEMPLATE&text=2026%E5%B9%B4%E8%AE%B2%E6%95%85%E4%BA%8B%E6%AF%94%E8%B5%9B%E2%80%94%E2%80%94%E6%8F%90%E4%BA%A4%E6%88%AA%E6%AD%A2&dates=20260920T235900/20260921T000000&details=%E8%A7%86%E9%A2%91%E6%8F%90%E4%BA%A4%E6%88%AA%E6%AD%A2%E6%97%A5%E3%80%82%E5%9C%A8+sowingkindness.org.sg%2Fzh%2Fsubmit%2F+%E6%8F%90%E4%BA%A4',
    outlook:'https://outlook.live.com/calendar/0/deeplink/compose?subject=2026%E5%B9%B4%E8%AE%B2%E6%95%85%E4%BA%8B%E6%AF%94%E8%B5%9B%E2%80%94%E2%80%94%E6%8F%90%E4%BA%A4%E6%88%AA%E6%AD%A2&startdt=2026-09-20T23:59:00&enddt=2026-09-21T00:00:00&body=%E8%A7%86%E9%A2%91%E6%8F%90%E4%BA%A4%E6%88%AA%E6%AD%A2%E6%97%A5&location=sowingkindness.org.sg',
    yahoo:'https://calendar.yahoo.com/?v=60&title=2026%E5%B9%B4%E8%AE%B2%E6%95%85%E4%BA%8B%E6%AF%94%E8%B5%9B%E2%80%94%E2%80%94%E6%8F%90%E4%BA%A4%E6%88%AA%E6%AD%A2&st=20260920T235900&et=20260921T000000&desc=%E8%A7%86%E9%A2%91%E6%8F%90%E4%BA%A4%E6%88%AA%E6%AD%A2%E6%97%A5',
    ical:'/calendar/storytelling-competition-2026.ics' },
  { tag:'家庭', date:'2026年6月21日', time:'全天', location:'社区活动摊位', title:'父亲节庆典', body:'亲子艺术手工活动，孩子为最爱的爸爸和父亲形象人物创作温暖纪念品。',
    gcal:'https://calendar.google.com/calendar/render?action=TEMPLATE&text=%E7%88%B6%E4%BA%B2%E8%8A%82%E5%BA%86%E5%85%B8%E2%80%94%E2%80%94%E6%92%AD%E7%A7%8D%E5%96%84%E6%84%8F%E5%8D%8F%E4%BC%9A&dates=20260621/20260622&details=%E4%BA%B2%E5%AD%90%E8%89%BA%E6%9C%AF%E6%89%8B%E5%B7%A5%E6%B4%BB%E5%8A%A8&location=%E7%A4%BE%E5%8C%BA%E6%B4%BB%E5%8A%A8%E6%91%8A%E4%BD%8D',
    outlook:'https://outlook.live.com/calendar/0/deeplink/compose?subject=%E7%88%B6%E4%BA%B2%E8%8A%82%E5%BA%86%E5%85%B8%E2%80%94%E2%80%94%E6%92%AD%E7%A7%8D%E5%96%84%E6%84%8F%E5%8D%8F%E4%BC%9A&startdt=2026-06-21&enddt=2026-06-22&body=%E4%BA%B2%E5%AD%90%E8%89%BA%E6%9C%AF%E6%89%8B%E5%B7%A5%E6%B4%BB%E5%8A%A8&location=%E7%A4%BE%E5%8C%BA%E6%B4%BB%E5%8A%A8%E6%91%8A%E4%BD%8D',
    yahoo:'https://calendar.yahoo.com/?v=60&title=%E7%88%B6%E4%BA%B2%E8%8A%82%E5%BA%86%E5%85%B8&st=20260621&et=20260622&desc=%E4%BA%B2%E5%AD%90%E8%89%BA%E6%9C%AF%E6%89%8B%E5%B7%A5%E6%B4%BB%E5%8A%A8',
    ical:'/calendar/fathers-day-2026.ics' },
  { tag:'家庭', date:'2026年9月25日', time:'傍晚', location:'待确认', title:'中秋节', body:'全家一起制作灯笼，庆祝团圆、光明与社区温暖。',
    gcal:'https://calendar.google.com/calendar/render?action=TEMPLATE&text=%E4%B8%AD%E7%A7%8B%E8%8A%82%E2%80%94%E2%80%94%E6%92%AD%E7%A7%8D%E5%96%84%E6%84%8F%E5%8D%8F%E4%BC%9A&dates=20260925T190000/20260925T210000&details=%E5%85%A8%E5%AE%B6%E4%B8%80%E8%B5%B7%E5%88%B6%E4%BD%9C%E7%81%AF%E7%AC%BC',
    outlook:'https://outlook.live.com/calendar/0/deeplink/compose?subject=%E4%B8%AD%E7%A7%8B%E8%8A%82%E2%80%94%E2%80%94%E6%92%AD%E7%A7%8D%E5%96%84%E6%84%8F%E5%8D%8F%E4%BC%9A&startdt=2026-09-25T19:00:00&enddt=2026-09-25T21:00:00&body=%E5%85%A8%E5%AE%B6%E4%B8%80%E8%B5%B7%E5%88%B6%E4%BD%9C%E7%81%AF%E7%AC%BC&location=%E5%BE%85%E7%A1%AE%E8%AE%A4',
    yahoo:'https://calendar.yahoo.com/?v=60&title=%E4%B8%AD%E7%A7%8B%E8%8A%82%E2%80%94%E2%80%94%E6%92%AD%E7%A7%8D%E5%96%84%E6%84%8F%E5%8D%8F%E4%BC%9A&st=20260925T190000&et=20260925T210000&desc=%E5%85%A8%E5%AE%B6%E4%B8%80%E8%B5%B7%E5%88%B6%E4%BD%9C%E7%81%AF%E7%AC%BC',
    ical:'/calendar/mid-autumn-2026.ics' },
  { tag:'家庭', date:'2026年12月初', time:'日期待确认', title:'圣诞节活动', body:"用善意承诺填满'礼物盒'，为我们的社区圣诞树装饰纸质挂件。",
    gcal:null, outlook:null, yahoo:null, ical:null },
];
---
<BaseLayout title="即将举行的活动 | 播种善意协会" description="家庭故事时光、学校项目、社区日和年度比赛——全年各种温柔的参与时刻。">

<section class="page-header">
  <div class="container">
    <div class="page-header__crumbs"><span>活动</span><span class="dot"></span><span>即将举行</span></div>
    <h1 style="font:700 clamp(36px,5.5vw,72px)/1.06 var(--serif);letter-spacing:-.02em;margin:0 0 16px">
      <span style="color:var(--ink-900)">加入我们——</span><span style="color:var(--forest-800)">总有</span><span style="color:var(--orange-500)">什么在生长。</span>
    </h1>
    <p style="font:400 18px/1.6 var(--sans);color:var(--ink-700);max-width:620px;margin:0">家庭故事时光、学校项目、社区日和年度比赛——全年各种温柔的参与时刻。</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="container">
    <div style="display:grid;gap:24px" data-stagger>
      {EVENTS.map(e => (
        <div class={`card ${e.img ? 'event-card-grid' : ''}`} style={`overflow:hidden;display:grid;grid-template-columns:${e.img ? '1.3fr 1fr' : '1fr'}`}>
          {e.img && (
            <div style="position:relative;min-height:280px">
              <img src={e.img} alt={e.title} style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
              <span class="pill pill--paper" style="position:absolute;left:16px;top:16px">{e.tag}</span>
              {e.featured && <span style="position:absolute;left:16px;bottom:16px;padding:8px 14px;border-radius:999px;background:var(--orange-600);color:#fff;font:700 12px var(--sans);letter-spacing:.06em;text-transform:uppercase">旗舰活动</span>}
            </div>
          )}
          <div style={`padding:${e.featured ? '32px 28px' : '24px 26px 28px'}`}>
            {!e.img && <span class="pill pill--sage" style="margin-bottom:14px;display:inline-flex">{e.tag}</span>}
            <div style="display:flex;align-items:center;gap:12px;color:var(--forest-800);margin-bottom:12px;flex-wrap:wrap;font:600 14px var(--sans)">
              <span>{e.date}</span>
              {e.time && <span style="color:var(--ink-500)">{e.time}</span>}
              {e.location && <span style="color:var(--ink-500)">{e.location}</span>}
            </div>
            <div style={`font:700 ${e.featured ? 30 : 22}px/1.25 var(--serif);color:var(--ink-900);margin-bottom:10px`}>{e.title}</div>
            <div class="heart-divider" style="margin-bottom:14px"><span class="line" style="width:20px"></span><span style="color:var(--heart)">♥</span><span class="line" style="width:20px"></span></div>
            <p style={`font:400 ${e.featured ? 16 : 15}px/1.65 var(--sans);color:var(--ink-700);margin:0 0 18px`}>{e.body}</p>

            <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
              <a href="/zh/submit/" class="btn btn-secondary">报名 <span class="chev">›</span></a>
            </div>

            {e.gcal ? (
              <div class="cal-section">
                <p class="cal-label">添加至日历</p>
                <div class="cal-row">
                  <a href={e.gcal} target="_blank" rel="noopener" class="cal-btn">
                    <span class="cal-icon" style="background:linear-gradient(135deg,#e8f0fe,#d2e3fc)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#4285F4" stroke-width="1.8" stroke-linecap="round"/>
                        <circle cx="8.5" cy="14.5" r="1.2" fill="#34A853"/>
                        <circle cx="12" cy="14.5" r="1.2" fill="#EA4335"/>
                        <circle cx="15.5" cy="14.5" r="1.2" fill="#FBBC05"/>
                      </svg>
                    </span>
                    <span class="cal-text">
                      <span class="cal-name">Google</span>
                      <span class="cal-sub">Google Calendar</span>
                    </span>
                    <svg class="cal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
                  </a>

                  <a href={e.ical} download class="cal-btn">
                    <span class="cal-icon" style="background:linear-gradient(135deg,#f0f0f0,#e4e4e4)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#333" stroke-width="1.8" stroke-linecap="round"/>
                        <path d="M12 12v4M10 14l2-2 2 2" stroke="#333" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="cal-text">
                      <span class="cal-name">Apple</span>
                      <span class="cal-sub">Apple Calendar</span>
                    </span>
                    <svg class="cal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
                  </a>

                  <a href={e.outlook} target="_blank" rel="noopener" class="cal-btn">
                    <span class="cal-icon" style="background:linear-gradient(135deg,#dff0ff,#c8e4fb)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#0078D4" stroke-width="1.8" stroke-linecap="round"/>
                        <rect x="8" y="12" width="8" height="5" rx="1" fill="#0078D4" opacity=".25"/>
                        <rect x="8" y="12" width="8" height="2.2" rx=".6" fill="#0078D4"/>
                      </svg>
                    </span>
                    <span class="cal-text">
                      <span class="cal-name">Outlook</span>
                      <span class="cal-sub">Outlook Calendar</span>
                    </span>
                    <svg class="cal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
                  </a>

                  <a href={e.yahoo} target="_blank" rel="noopener" class="cal-btn">
                    <span class="cal-icon" style="background:linear-gradient(135deg,#ede8fb,#ddd0f7)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M6 2v2M18 2v2M3 8h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="#6001D2" stroke-width="1.8" stroke-linecap="round"/>
                        <text x="12" y="19.5" font-size="6.5" font-weight="900" fill="#6001D2" text-anchor="middle" font-family="sans-serif">Y!</text>
                      </svg>
                    </span>
                    <span class="cal-text">
                      <span class="cal-name">Yahoo</span>
                      <span class="cal-sub">Yahoo Calendar</span>
                    </span>
                    <svg class="cal-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
                  </a>
                </div>
              </div>
            ) : (
              <span style="font:500 13px var(--sans);color:var(--ink-400)">日期待确认</span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .cal-section { padding-top: 4px; }
  .cal-label {
    font: 600 10.5px/1 var(--sans);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin: 0 0 10px;
  }
  .cal-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .cal-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px 10px 10px;
    background: #fff;
    border: 1px solid rgba(0,0,0,.07);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink-900);
    box-shadow: 0 1px 4px rgba(0,0,0,.05);
    transition: transform 160ms cubic-bezier(.34,1.56,.64,1), box-shadow 160ms ease, border-color 160ms ease;
    position: relative;
    overflow: hidden;
  }
  .cal-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,.6) 0%, transparent 50%);
    pointer-events: none;
  }
  .cal-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 18px rgba(0,0,0,.10), 0 2px 6px rgba(0,0,0,.06);
    border-color: rgba(0,0,0,.12);
  }
  .cal-btn:active { transform: translateY(-1px); transition-duration: 60ms; }
  .cal-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cal-text { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .cal-name { font: 700 13px/1.2 var(--sans); color: var(--ink-900); }
  .cal-sub { font: 400 10.5px/1.2 var(--sans); color: var(--ink-400); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cal-arrow { color: var(--ink-300); flex-shrink: 0; opacity: .5; }
  .cal-btn:hover .cal-arrow { opacity: .9; }
</style>
