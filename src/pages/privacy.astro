---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy | Sowing Kindness Society" description="Privacy policy for Sowing Kindness Society — how we collect, use and protect your personal data in accordance with Singapore's PDPA.">

<section class="page-header">
  <div class="container">
    <div class="page-header__crumbs"><span>Legal</span><span class="dot"></span><span>Privacy Policy</span></div>
    <h1 style="font:700 clamp(32px,5vw,64px)/1.06 var(--serif);letter-spacing:-.02em;margin:0 0 14px">
      <span style="color:var(--ink-900)">Privacy </span><span style="color:var(--forest-800)">Policy</span>
    </h1>
    <p style="font:400 16px/1.6 var(--sans);color:var(--ink-700);max-width:600px;margin:0">Last updated: June 2026</p>
  </div>
</section>

<section class="section" style="padding-top:40px;padding-bottom:80px">
  <div class="container" style="max-width:760px">

    <div class="card card--quiet" style="padding:24px 28px;margin-bottom:40px;background:var(--sage-50)">
      <p style="font:400 15px/1.7 var(--sans);color:var(--ink-700);margin:0">Sowing Kindness Society ("we", "us", "our") is committed to protecting the personal data of our members, participants, supporters and website visitors. This Privacy Policy explains how we collect, use, disclose and protect your personal data in accordance with Singapore's <strong>Personal Data Protection Act 2012 (PDPA)</strong>.</p>
    </div>

    {[
      {
        n:1, title:'Data We Collect',
        body:`We may collect the following personal data when you interact with us:
<ul class="article-ul">
  <li><strong>Contact information</strong> — name, email address, mobile number</li>
  <li><strong>Registration data</strong> — child's name, age, school or centre, storytelling language, age category</li>
  <li><strong>Submitted content</strong> — storytelling videos and synopses submitted for our competition</li>
  <li><strong>Correspondence</strong> — messages sent via our contact form or email</li>
  <li><strong>Technical data</strong> — IP address, browser type and pages visited (collected automatically via standard web logs)</li>
</ul>`
      },
      {
        n:2, title:'How We Use Your Data',
        body:`We use your personal data only for the purposes for which it was collected:
<ul class="article-ul">
  <li>To process competition registrations and administer the competition</li>
  <li>To communicate with you about events, results and competition updates</li>
  <li>To publish competition results, photographs and videos on our website and social media (with consent)</li>
  <li>To respond to your enquiries</li>
  <li>To improve our website and programmes</li>
</ul>
<p class="article-p">We will not use your personal data for any purpose beyond what is stated here without your prior consent.</p>`
      },
      {
        n:3, title:'Disclosure of Personal Data',
        body:`<p class="article-p">We do not sell, rent or trade your personal data. We may share your data with:</p>
<ul class="article-ul">
  <li><strong>Service providers</strong> — third-party platforms that assist us in operating our website and services (e.g. Cloudflare, Resend, Google), bound by confidentiality obligations</li>
  <li><strong>Authorities</strong> — when required by law or regulation</li>
</ul>
<p class="article-p">All third-party providers are required to handle your data securely and in accordance with applicable data protection laws.</p>`
      },
      {
        n:4, title:'Retention of Data',
        body:`<p class="article-p">We retain personal data only for as long as necessary to fulfil the purposes for which it was collected, or as required by law. Competition registration data is typically retained for one year after the competition concludes. Video submissions shared publicly remain available until withdrawn.</p>`
      },
      {
        n:5, title:'Your Rights',
        body:`<p class="article-p">Under Singapore's PDPA, you have the right to:</p>
<ul class="article-ul">
  <li><strong>Access</strong> — request a copy of the personal data we hold about you</li>
  <li><strong>Correction</strong> — request corrections to inaccurate or incomplete data</li>
  <li><strong>Withdrawal of consent</strong> — withdraw consent for us to collect, use or disclose your data at any time</li>
</ul>
<p class="article-p">To exercise any of these rights, please contact us at <a href="mailto:contact@sowingkindness.org.sg" style="color:var(--fern-600);font-weight:600">contact@sowingkindness.org.sg</a>. We will respond within 30 days.</p>`
      },
      {
        n:6, title:'Cookies and Tracking',
        body:`<p class="article-p">Our website uses standard web technologies (including cookies) to improve your browsing experience and collect anonymous usage statistics. We do not use cookies for advertising or to track you across other websites. You may disable cookies in your browser settings; this will not affect your ability to use the website.</p>`
      },
      {
        n:7, title:'Security',
        body:`<p class="article-p">We take reasonable technical and organisational measures to protect your personal data against unauthorised access, disclosure, alteration or destruction. Our website uses HTTPS encryption. However, no method of transmission over the internet is completely secure, and we cannot guarantee absolute security.</p>`
      },
      {
        n:8, title:'Changes to This Policy',
        body:`<p class="article-p">We may update this Privacy Policy from time to time. The most current version will always be available at <strong>sowingkindness.org.sg/privacy/</strong>. Continued use of our website or services after any changes constitutes your acceptance of the updated policy.</p>`
      },
      {
        n:9, title:'Contact Us',
        body:`<p class="article-p">If you have any questions about this Privacy Policy or how we handle your personal data, please contact:</p>
<p class="article-p"><strong>Sowing Kindness Society</strong><br/>Email: <a href="mailto:contact@sowingkindness.org.sg" style="color:var(--fern-600);font-weight:600">contact@sowingkindness.org.sg</a></p>`
      },
    ].map(s => (
      <div data-fade style="margin-bottom:40px;padding-bottom:36px;border-bottom:1px solid var(--border)">
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px">
          <span style="width:36px;height:36px;border-radius:999px;background:var(--sage-200);color:var(--forest-800);font:700 15px var(--sans);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">{s.n}</span>
          <h2 style="font:700 22px var(--serif);color:var(--forest-800);margin:0">{s.title}</h2>
        </div>
        <div style="padding-left:50px" set:html={s.body} />
      </div>
    ))}

  </div>
</section>

</BaseLayout>
