---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ARTICLES } from '../../lib/articles';
import { renderSection } from '../../lib/renderArticle';

export function getStaticPaths() {
  return ARTICLES.map(a => ({ params: { slug: a.slug }, props: { article: a } }));
}

const { article } = Astro.props;
const related = ARTICLES.filter(a => article.relatedSlugs.includes(a.slug));
const bodyHtml = article.body.map(renderSection).join('');
const initials = article.author.split(' ').map((w: string) => w[0]).join('');

const pageUrl = encodeURIComponent(`https://www.sowingkindness.org.sg/stories/${article.slug}/`);
const pageTitle = encodeURIComponent(article.title);
const shareLinks = {
  facebook:  `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`,
  whatsapp:  `https://api.whatsapp.com/send?text=${pageTitle}%20https%3A%2F%2Fwww.sowingkindness.org.sg%2Fstories%2F${encodeURIComponent(article.slug)}%2F`,
  x:         `https://twitter.com/intent/tweet?text=${pageTitle}&url=${pageUrl}`,
  linkedin:  `https://www.linkedin.com/sharing/share-offsite/?url=${pageUrl}`,
};
---
<BaseLayout
  title={article.metaTitle}
  description={article.metaDescription}
  image={article.image}
  author={article.author}
  publishDate={article.date}
  type="article"
>

<section style="background:linear-gradient(180deg,var(--cream-100),var(--cream-200) 60%,var(--cream-100));padding:56px 0 0;overflow:hidden">
  <div class="container">
    <div class="page-header__crumbs">
      <a href="/stories/" style="color:var(--fern-600)">Stories</a>
      <span class="dot"></span>
      <span style="color:var(--ink-500)">{article.tag}</span>
    </div>
    <div class="grid-2col" style="margin-top:20px">
      <div id="article-hero-content">
        <span class="pill pill--sage" style="margin-bottom:18px;display:inline-flex">{article.tag}</span>
        <h1 style="font:700 clamp(26px,4vw,52px)/1.08 var(--serif);color:var(--ink-900);letter-spacing:-.02em;margin:0 0 18px">{article.title}</h1>
        <p style="font:400 18px/1.6 var(--sans);color:var(--ink-700);margin:0 0 24px;max-width:540px">{article.intro}</p>
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <div style="display:flex;align-items:center;gap:10px">
            <div style="width:40px;height:40px;border-radius:999px;background:var(--sage-200);color:var(--forest-800);font:700 15px var(--serif);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">{initials}</div>
            <div>
              <div style="font:700 14px var(--sans);color:var(--forest-800)">{article.author}</div>
              <div style="font:400 12px var(--sans);color:var(--ink-500)">{article.authorRole}</div>
            </div>
          </div>
          <span style="width:1px;height:28px;background:var(--sage-200);display:inline-block"></span>
          <span style="font:500 13px var(--sans);color:var(--ink-500)">{article.date}</span>
          <span style="width:1px;height:28px;background:var(--sage-200);display:inline-block"></span>
          <span style="font:500 13px var(--sans);color:var(--ink-500)">{article.readTime}</span>
        </div>
      </div>
      <div id="article-hero-img" style="border-radius:24px;overflow:hidden;position:relative">
        <img src={article.image} alt={article.title} style="width:100%;height:auto;display:block" loading="eager" />
      </div>
    </div>
  </div>
  <div style="height:40px"></div>
</section>

<section class="section" style="padding-top:56px">
  <div class="container article-layout">
    <div style="padding-right:32px" class="hide-tablet">
      <div style="position:sticky;top:120px;display:flex;flex-direction:column;align-items:flex-end;gap:10px">
        <div style="font:600 11px var(--sans);color:var(--ink-300);letter-spacing:.1em;text-transform:uppercase;margin-bottom:2px">Share</div>

        <!-- Facebook -->
        <a href={shareLinks.facebook} target="_blank" rel="noopener" class="share-icon-btn" title="Share on Facebook" style="--c:#1877F2">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>

        <!-- WhatsApp -->
        <a href={shareLinks.whatsapp} target="_blank" rel="noopener" class="share-icon-btn" title="Share on WhatsApp" style="--c:#25D366">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>

        <!-- X -->
        <a href={shareLinks.x} target="_blank" rel="noopener" class="share-icon-btn" title="Share on X" style="--c:#000">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.629 5.905-5.629Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>

        <!-- LinkedIn -->
        <a href={shareLinks.linkedin} target="_blank" rel="noopener" class="share-icon-btn" title="Share on LinkedIn" style="--c:#0A66C2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>

        <!-- Copy link -->
        <button id="copy-link" class="share-icon-btn" title="Copy link" style="--c:var(--forest-800);cursor:pointer;border:none;background:none;padding:0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
        </button>
      </div>
    </div>

    <article id="article-body">
      <div set:html={bodyHtml} />
      <div style="margin-top:44px;padding-top:26px;border-top:1px solid var(--border)">
        <div style="font:600 12px var(--sans);color:var(--ink-300);letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px">Topics</div>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {article.keywords.map((k: string) => <span class="pill pill--sage">{k}</span>)}
        </div>
      </div>
      <!-- Mobile share bar (hidden on desktop where sidebar shows) -->
      <div class="mobile-share-bar">
        <span style="font:600 12px var(--sans);color:var(--ink-400);letter-spacing:.08em;text-transform:uppercase;flex-shrink:0">Share</span>
        <a href={shareLinks.facebook} target="_blank" rel="noopener" class="share-pill" style="--c:#1877F2;--bg:#e8f0fb">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
        <a href={shareLinks.whatsapp} target="_blank" rel="noopener" class="share-pill" style="--c:#128C7E;--bg:#e4f5ef">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          WhatsApp
        </a>
        <a href={shareLinks.x} target="_blank" rel="noopener" class="share-pill" style="--c:#000;--bg:#f0f0f0">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.629 5.905-5.629Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X
        </a>
        <a href={shareLinks.linkedin} target="_blank" rel="noopener" class="share-pill" style="--c:#0A66C2;--bg:#e4eef8">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <button id="copy-link-mobile" class="share-pill" style="--c:var(--forest-800);--bg:var(--sage-50);cursor:pointer;border:none;background:var(--bg)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
          Copy link
        </button>
      </div>

      <div style="margin-top:32px;padding:22px 26px;border-radius:18px;background:var(--sage-50);display:flex;gap:16px;align-items:flex-start">
        <div style="width:52px;height:52px;border-radius:999px;background:var(--sage-200);color:var(--forest-800);font:700 18px var(--serif);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0">{initials}</div>
        <div>
          <div style="font:700 17px var(--serif);color:var(--forest-800);margin-bottom:3px">{article.author}</div>
          <div style="font:500 12px var(--sans);color:var(--fern-600);margin-bottom:8px">{article.authorRole}</div>
          <p style="font:400 14px/1.6 var(--sans);color:var(--ink-700);margin:0">A contributor to the Sowing Kindness Society reading room, writing about kindness, family life and raising kind children in Singapore.</p>
        </div>
      </div>
      <div style="margin-top:32px">
        <a href="/stories/" style="display:inline-flex;align-items:center;gap:8px;font:600 15px var(--sans);color:var(--forest-800)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
          Back to all stories
        </a>
      </div>
    </article>
    <div></div>
  </div>
</section>

{related.length > 0 && (
  <section class="section section--cream" style="padding-top:56px;padding-bottom:72px">
    <div class="container">
      <h2 data-fade style="font:700 clamp(22px,3.2vw,40px)/1.1 var(--serif);margin:0 0 32px">
        <span style="color:var(--ink-900)">Keep </span><span style="color:var(--forest-800)">reading.</span>
      </h2>
      <div class="grid-2col-sm" data-stagger>
        {related.map(r => (
          <a href={`/stories/${r.slug}/`} style="display:block;text-decoration:none;color:inherit">
            <article class="card" style="overflow:hidden">
              <div style="position:relative;height:200px">
                <img src={r.image} alt={r.title} style="width:100%;height:100%;object-fit:cover;display:block" loading="lazy" />
                <span class="pill pill--paper" style="position:absolute;left:16px;bottom:14px">{r.tag}</span>
              </div>
              <div style="padding:18px 22px 22px">
                <div style="font:500 12px var(--sans);color:var(--ink-500);margin-bottom:8px">{r.date} &middot; {r.readTime}</div>
                <div style="font:700 20px/1.3 var(--serif);color:var(--ink-900);margin-bottom:8px">{r.title}</div>
                <span class="link-arrow">Read story &rsaquo;</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section style="background:var(--forest-900);padding:52px 0">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap">
    <div>
      <div style="font:700 22px/1.2 var(--serif);color:#fff;margin-bottom:8px">Does your child have a kindness story to tell?</div>
      <p style="font:400 15px var(--sans);color:rgba(255,255,255,.75);margin:0;max-width:460px">Free to enter. Submissions close 20 September 2026.</p>
    </div>
    <a href="/submit/" class="btn btn-primary" style="flex-shrink:0">Register Now <span class="chev">&rsaquo;</span></a>
  </div>
</section>

</BaseLayout>

<style>
  /* ── Sticky sidebar share buttons ── */
  .share-icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--paper, #fff);
    border: 1.5px solid var(--border, #e5e7eb);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-600, #4b5563);
    text-decoration: none;
    transition: transform 140ms cubic-bezier(.34,1.56,.64,1), box-shadow 140ms ease, color 140ms ease, border-color 140ms ease;
  }
  .share-icon-btn:hover {
    color: var(--c);
    border-color: var(--c);
    transform: translateY(-2px) scale(1.08);
    box-shadow: 0 4px 12px rgba(0,0,0,.10);
  }

  /* ── Mobile share bar ── */
  .mobile-share-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin: 32px 0 24px;
    padding: 18px 20px;
    background: var(--cream-100, #fafaf7);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 16px;
  }
  @media (min-width: 900px) {
    .mobile-share-bar { display: none; }
  }
  .share-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 999px;
    background: var(--bg);
    color: var(--c);
    font: 600 12px var(--sans, sans-serif);
    text-decoration: none;
    border: none;
    transition: transform 120ms ease, box-shadow 120ms ease, filter 120ms ease;
    white-space: nowrap;
  }
  .share-pill:hover {
    transform: translateY(-2px);
    box-shadow: 0 3px 10px rgba(0,0,0,.10);
    filter: brightness(.94);
  }
</style>

<script>
import { gsap } from 'gsap';
function copyLink() {
  navigator.clipboard?.writeText(window.location.href);
}
document.getElementById('copy-link')?.addEventListener('click', copyLink);
document.getElementById('copy-link-mobile')?.addEventListener('click', copyLink);
const heroContent = document.querySelectorAll('#article-hero-content > *');
const heroImg = document.getElementById('article-hero-img');
if (heroContent.length) gsap.from(heroContent, { y: 28, stagger: 0.08, duration: 0.65, ease: 'power3.out', clearProps: 'transform' });
if (heroImg) gsap.from(heroImg, { y: 18, duration: 0.8, ease: 'power3.out', delay: 0.1, clearProps: 'transform' });
</script>
