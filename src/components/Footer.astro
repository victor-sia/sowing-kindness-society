---
const path = Astro.url.pathname;
const isZh = path.startsWith('/zh/') || path === '/zh';
const base = isZh ? '/zh' : '';

const T = isZh ? {
  desc:    '总部位于新加坡的非营利组织，在儿童、家庭和社区中培育善意、同理心与正向价值观。',
  tagline: '让我们一起播撒善意，静待花开。',
  explore: '探索',
  comp:    '比赛',
  stay:    '保持联系',
  stayDesc:'温柔故事与活动更新，每月一次。',
  subscribe:'订阅',
  copyright:'© 2026 播种善意协会 新加坡。保留所有权利。',
  by:      '网站由',
  privacy: '隐私政策',
  terms:   '使用条款',
} : {
  desc:    'A Singapore-based non-profit nurturing kindness, compassion and positive values in children, families and communities.',
  tagline: "Together, let's sow kindness and watch it grow.",
  explore: 'Explore',
  comp:    'Competition',
  stay:    'Stay Updated',
  stayDesc:'Gentle stories and updates, once a month.',
  subscribe:'Subscribe',
  copyright:'© 2026 Sowing Kindness Society Singapore. All rights reserved.',
  by:      'Website by',
  privacy: 'Privacy',
  terms:   'Terms',
};

const explore = isZh ? [
  [`${base}/`, '首页'],
  [`${base}/about/`, '关于我们'],
  [`${base}/stories/`, '温情故事'],
  [`${base}/watch/`, '观看'],
  [`${base}/events/upcoming/`, '即将举行的活动'],
  [`${base}/events/past/`, '往届活动'],
  [`${base}/contact/`, '联系我们'],
] : [
  ['/', 'Home'],
  ['/about/', 'About'],
  ['/stories/', 'Stories'],
  ['/watch/', 'Watch'],
  ['/events/upcoming/', 'Upcoming Events'],
  ['/events/past/', 'Past Events'],
  ['/contact/', 'Contact'],
];

const comp = isZh ? [
  [`${base}/competition/`, '比赛'],
  [`${base}/rules/`, '官方规则'],
  [`${base}/consent/`, '同意书'],
  [`${base}/submit/`, '提交视频'],
] : [
  ['/competition/', 'Competition'],
  ['/rules/', 'Official Rules'],
  ['/consent/', 'Consent Form'],
  ['/submit/', 'Submit a Video'],
];

const dandelionImg = '/images/girl-dandelion.webp';
---
<footer class="footer" style="position:relative;overflow:hidden">
  <div aria-hidden="true" style={`position:absolute;inset:0;pointer-events:none;background-image:url('${dandelionImg}');background-size:cover;background-position:center 30%;opacity:0.20;filter:blur(3px) saturate(0.4) brightness(0.9);mask-image:radial-gradient(ellipse 80% 100% at 50% 50%, black 20%, transparent 80%);-webkit-mask-image:radial-gradient(ellipse 80% 100% at 50% 50%, black 20%, transparent 80%)`}></div>
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(135deg, rgba(255,245,220,0.06) 0%, rgba(255,235,180,0.04) 60%, transparent 100%);"></div>
  <div class="container" style="position:relative;z-index:1">
    <div class="footer-grid">
      <div>
        <img src="/logo/sks-logo-transparent-sm.webp" alt="Sowing Kindness Society" width="200" height="104"
          style="height:100px;width:auto;margin-bottom:14px;filter:brightness(0) invert(1)" />
        <p style="font:400 14px/1.6 var(--sans);margin:0;opacity:.85;max-width:320px">{T.desc}</p>
        <p style="font:400 13px/1.6 var(--sans);margin-top:14px;opacity:.7">{T.tagline}</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:18px">

          <!-- WhatsApp -->
          <a href="https://wa.me/6586782384" target="_blank" rel="noopener" aria-label="WhatsApp" class="footer-social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          </a>

          <!-- Facebook -->
          <a href="https://www.facebook.com/sowingkindness.org.sg" target="_blank" rel="noopener" aria-label="Facebook" class="footer-social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>

          <!-- Instagram -->
          <a href="https://instagram.com/sowingkindness.org.sg" target="_blank" rel="noopener" aria-label="Instagram" class="footer-social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>

          <!-- X -->
          <a href="https://x.com/sowingkindnessorgsg" target="_blank" rel="noopener" aria-label="X" class="footer-social-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.629 5.905-5.629Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>

          <!-- GanjingWorld -->
          <a href="https://www.ganjingworld.com/@sowingkindness" target="_blank" rel="noopener" aria-label="GanjingWorld" class="footer-social-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="20" height="20">
              <path fill="#fff" d="M397.06,262.26l.23-65.14,50.78.03-.2,66.12c-2.79,104.84-89.38,183.47-191.71,183.52-104.47.05-189.18-80.28-192.52-184.83-3.44-107.65,81.44-198.07,191.11-196.98l61.46.04-.03,50.62-64.82.04c-74.99.05-134.08,60.85-136.89,133.95-3.1,80.91,59.25,145.52,139.71,146.46,75.45.88,140.58-55.8,142.88-133.84Z"/>
              <path fill="#fff" d="M196.1,247.77c-2.21,18.45,2.55,35.41,14.5,48.65,11.57,12.82,27.47,18.48,45.44,18.8,31.9.57,59.07-22.64,60.2-55.3l-.15-12.26-60.8-.04-.07-50.63,111.96.02-.17,63.62c-1.48,60.97-51.63,105.37-110.9,105.46-64.83.1-116.66-52.54-110.86-118.59l50.85.28Z"/>
              <polygon fill="#fff" points="421.74 131.15 381.39 171.51 340.91 131.32 381.37 91.05 421.74 131.15"/>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a href="https://linkedin.com/company/sowingkindness-org-sg" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer-social-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>

        </div>

<style>
  .footer-social-btn {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 150ms ease, transform 150ms ease;
    flex-shrink: 0;
  }
  .footer-social-btn:hover {
    background: rgba(255,255,255,.24);
    transform: translateY(-2px);
  }
</style>
      </div>

      <div>
        <h4 style="font:700 13px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:#fff;margin-bottom:14px;margin-top:0">{T.explore}</h4>
        <ul style="list-style:none;padding:0;margin:0;display:grid;gap:10px;font:400 14px var(--sans)">
          {explore.map(([href,label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 style="font:700 13px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:#fff;margin-bottom:14px;margin-top:0">{T.comp}</h4>
        <ul style="list-style:none;padding:0;margin:0;display:grid;gap:10px;font:400 14px var(--sans)">
          {comp.map(([href,label]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4 style="font:700 13px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:#fff;margin-bottom:14px;margin-top:0">{T.stay}</h4>
        <p style="font:400 14px/1.5 var(--sans);opacity:.85;margin-bottom:12px">{T.stayDesc}</p>
        <div style="display:flex;gap:8px">
          <input placeholder={isZh ? 'you@email.com' : 'you@email.com'} style="flex:1;padding:12px 16px;border-radius:999px;border:none;font:400 14px var(--sans);background:rgba(255,255,255,.10);color:#fff;outline:none" />
          <button class="btn btn-primary" style="padding:12px 16px">{T.subscribe}</button>
        </div>
      </div>
    </div>

    <hr />

    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;font:400 13px var(--sans);opacity:.7">
      <span>{T.copyright}</span>
      <span>
        {T.by} <a href="https://digitalreconnect.sg/" target="_blank" style="color:#fff;text-decoration:underline">Digital Reconnect</a>
        · <a href={`${base}/privacy/`}>{T.privacy}</a> · <a href={`${base}/terms/`}>{T.terms}</a>
      </span>
    </div>
  </div>
</footer>
