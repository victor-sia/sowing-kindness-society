---
interface Props { currentPath: string; }
const { currentPath } = Astro.props;

const isZh = currentPath.startsWith('/zh/') || currentPath === '/zh';
const base  = isZh ? '/zh' : '';

// Language toggle target URLs
const enPath = isZh ? (currentPath.replace(/^\/zh/, '') || '/') : currentPath;
const zhPath = isZh ? currentPath : ('/zh' + (currentPath === '/' ? '/' : currentPath));

// Translated labels
const T = isZh ? {
  home:'首页', about:'关于我们', comp:'比赛', rules:'比赛规则',
  consent:'同意书', submit:'提交视频', events:'活动',
  upcoming:'即将举行', past:'往届活动', stories:'温情故事',
  read:'阅读', watch:'观看', contact:'联系我们',
  learnMore:'关于我们', register:'立即报名',
} : {
  home:'Home', about:'About', comp:'Competition', rules:'Official Rules',
  consent:'Consent Form', submit:'Submit a Video', events:'Events',
  upcoming:'Upcoming Events', past:'Past Events', stories:'Inspire Stories',
  read:'Read', watch:'Watch', contact:'Contact',
  learnMore:'About Us', register:'Register Now',
};

const compDropdown = [
  { label:T.comp,    href:`${base}/competition/` },
  { label:T.rules,   href:`${base}/rules/` },
  { label:T.consent, href:`${base}/consent/` },
  { label:T.submit,  href:`${base}/submit/` },
];

const storiesDropdown = [
  { label:T.read,  href:`${base}/stories/` },
  { label:T.watch, href:`${base}/watch/` },
];

const eventsDropdown = [
  { label:T.upcoming, href:`${base}/events/upcoming/` },
  { label:T.past,     href:`${base}/events/past/` },
];

function isActive(href: string) {
  if (href === '/' || href === '/zh/') return currentPath === href;
  return currentPath.startsWith(href);
}
const compActive   = compDropdown.some(d => currentPath.startsWith(d.href));
const eventsActive = eventsDropdown.some(d => currentPath.startsWith(d.href));
const storiesActive = storiesDropdown.some(d => currentPath.startsWith(d.href));
---

<header class="nav" id="site-nav">
  <div class="container nav__inner">
    <a href={isZh ? '/zh/' : '/'} class="nav__logo">
      <img src="/logo/sks-logo-transparent.webp" alt="Sowing Kindness Society" width="200" height="62" />
    </a>

    <nav class="nav__links">
      <a href={isZh ? '/zh/' : '/'} class={`nav__link${isActive(isZh ? '/zh/' : '/') ? ' active' : ''}`}>{T.home}</a>
      <a href={`${base}/about/`} class={`nav__link${isActive(`${base}/about/`) ? ' active' : ''}`}>{T.about}</a>

      <!-- Competition dropdown -->
      <div class={`nav__drop-wrap${compActive ? ' active' : ''}`}>
        <a href={`${base}/competition/`} class={`nav__link nav__link--drop${compActive ? ' active' : ''}`}>
          {T.comp}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="nav__caret"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="nav__dropdown">
          {compDropdown.map(d => (
            <a href={d.href} class={`nav__dropdown-item${currentPath.startsWith(d.href) ? ' active' : ''}`}>{d.label}</a>
          ))}
        </div>
      </div>

      <!-- Events dropdown -->
      <div class={`nav__drop-wrap${eventsActive ? ' active' : ''}`}>
        <a href={`${base}/events/upcoming/`} class={`nav__link nav__link--drop${eventsActive ? ' active' : ''}`}>
          {T.events}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="nav__caret"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="nav__dropdown">
          {eventsDropdown.map(d => (
            <a href={d.href} class={`nav__dropdown-item${currentPath.startsWith(d.href) ? ' active' : ''}`}>{d.label}</a>
          ))}
        </div>
      </div>

      <!-- Stories dropdown -->
      <div class={`nav__drop-wrap${storiesActive ? ' active' : ''}`}>
        <a href={`${base}/stories/`} class={`nav__link nav__link--drop${storiesActive ? ' active' : ''}`}>
          {T.stories}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="nav__caret"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="nav__dropdown">
          {storiesDropdown.map(d => (
            <a href={d.href} class={`nav__dropdown-item${currentPath.startsWith(d.href) ? ' active' : ''}`}>{d.label}</a>
          ))}
        </div>
      </div>

      <a href={`${base}/contact/`} class={`nav__link${isActive(`${base}/contact/`) ? ' active' : ''}`}>{T.contact}</a>
    </nav>

    <div class="nav__cta">
      <!-- Language toggle -->
      <div class="lang-toggle">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="lang-globe"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>
        <a href={enPath} class={`lang-btn${!isZh ? ' active' : ''}`}>EN</a>
        <span class="lang-divider"></span>
        <a href={zhPath} class={`lang-btn${isZh ? ' active' : ''}`}>中文</a>
      </div>
      <a href={`${base}/about/`} class="btn btn-outline">{T.learnMore}</a>
      <a href={`${base}/submit/`} class="btn btn-primary" aria-label="Register for the storytelling competition">{T.register} <span class="chev">›</span></a>
    </div>

    <!-- Mobile-only language toggle (sits left of burger) -->
    <div class="lang-toggle lang-toggle--mobile-bar">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="lang-globe"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>
      <a href={enPath} class={`lang-btn${!isZh ? ' active' : ''}`}>EN</a>
      <span class="lang-divider"></span>
      <a href={zhPath} class={`lang-btn${isZh ? ' active' : ''}`}>中文</a>
    </div>

    <button class="nav__burger" id="nav-burger" aria-label="Open menu">
      <svg id="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile drawer -->
<div class="nav__drawer" id="nav-drawer">
  <nav>
    <a href={isZh ? '/zh/' : '/'} class={`nav__link${isActive(isZh ? '/zh/' : '/') ? ' active' : ''}`}>{T.home}</a>
    <a href={`${base}/about/`} class={`nav__link${isActive(`${base}/about/`) ? ' active' : ''}`}>{T.about}</a>
    <div class="nav__drawer-group">
      <div class="nav__drawer-group-label">{T.comp}</div>
      {compDropdown.map(d => (
        <a href={d.href} class={`nav__link nav__link--sub${currentPath.startsWith(d.href) ? ' active' : ''}`}>{d.label}</a>
      ))}
    </div>
    <div class="nav__drawer-group">
      <div class="nav__drawer-group-label">{T.events}</div>
      {eventsDropdown.map(d => (
        <a href={d.href} class={`nav__link nav__link--sub${currentPath.startsWith(d.href) ? ' active' : ''}`}>{d.label}</a>
      ))}
    </div>
    <div class="nav__drawer-group">
      <div class="nav__drawer-group-label">{T.stories}</div>
      {storiesDropdown.map(d => (
        <a href={d.href} class={`nav__link nav__link--sub${currentPath.startsWith(d.href) ? ' active' : ''}`}>{d.label}</a>
      ))}
    </div>
    <a href={`${base}/contact/`} class={`nav__link${isActive(`${base}/contact/`) ? ' active' : ''}`}>{T.contact}</a>
  </nav>
  <div class="nav__drawer-cta">
    <a href={`${base}/about/`} class="btn btn-outline">{T.learnMore}</a>
    <a href={`${base}/submit/`} class="btn btn-primary" aria-label="Register for the storytelling competition">{T.register} <span class="chev">›</span></a>
  </div>
  <div style="margin-top:32px;padding:16px 0;border-top:1px solid rgba(31,77,31,.08);font:400 13px var(--sans);color:var(--ink-500)">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
      <span style="color:var(--heart)">♥</span>
      <span style="font:600 14px var(--serif);color:var(--forest-800)">{isZh ? '播撒善意，静待花开' : 'Sow Kindness, Watch It Grow'}</span>
    </div>
    <div>contact@sowingkindness.org.sg</div>
  </div>
</div>

<style>
/* ── Language toggle ── */
.lang-toggle {
  display:flex;align-items:center;gap:0;
  font:700 12px var(--sans);
  background:var(--forest-800);
  border-radius:999px;
  padding:4px 4px 4px 12px;
  flex-shrink:0;
  box-shadow:0 2px 8px rgba(31,77,31,.25);
  color:rgba(255,255,255,.7);
}
.lang-globe {
  flex-shrink:0;
  margin-right:6px;
  stroke:rgba(255,255,255,.7);
}
.lang-btn {
  padding:5px 11px;
  border-radius:999px;
  color:rgba(255,255,255,.65);
  transition:background .15s,color .15s;
  white-space:nowrap;
  line-height:1;
  letter-spacing:.02em;
}
.lang-btn.active {
  background:rgba(255,255,255,.18);
  color:#fff;
}
.lang-btn:hover:not(.active) { color:rgba(255,255,255,.9); }
.lang-divider {
  width:1px;height:12px;
  background:rgba(255,255,255,.25);
  flex-shrink:0;
}

/* Mobile bar toggle — hidden on desktop, shown on mobile */
.lang-toggle--mobile-bar { display:none; }

@media(max-width:1023px) {
  /* Hide the desktop toggle inside nav__cta */
  .nav__cta .lang-toggle { display:none; }
  /* Show the mobile bar toggle */
  .lang-toggle--mobile-bar { display:flex; }
}

.lang-toggle--mobile {
  display:flex;flex-direction:column;gap:0;
  border:1.5px solid rgba(31,77,31,.15);
  border-radius:12px;overflow:hidden;
  margin:16px 0 4px;
}
.lang-toggle--mobile .lang-btn {
  padding:12px 16px;font-size:15px;
  border-bottom:1px solid rgba(31,77,31,.08);
}
.lang-toggle--mobile .lang-btn:last-child { border-bottom:none; }

/* ── Dropdown wrapper ── */
.nav__drop-wrap {
  position:relative;
  display:inline-flex;
  align-items:center;
}
.nav__link--drop {
  display:inline-flex;
  align-items:center;
  gap:4px;
}
.nav__caret {
  transition:transform .2s;
  flex-shrink:0;
}

.nav__dropdown {
  position:absolute;
  top:100%;
  left:50%;
  transform:translateX(-50%);
  min-width:180px;
  background:#fff;
  border-radius:14px;
  box-shadow:0 8px 28px rgba(31,77,31,.12),0 2px 6px rgba(31,77,31,.06);
  padding:16px 8px 8px;
  z-index:200;
  border:1px solid rgba(31,77,31,.07);
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transition:opacity .15s .12s, visibility .15s .12s, transform .15s .12s;
  transform:translateX(-50%) translateY(-4px);
}
.nav__dropdown::before {
  content:'';
  position:absolute;
  top:9px;
  left:50%;
  transform:translateX(-50%) rotate(45deg);
  width:11px;height:11px;
  background:#fff;
  border-left:1px solid rgba(31,77,31,.07);
  border-top:1px solid rgba(31,77,31,.07);
}
.nav__dropdown::after {
  content:'';
  position:absolute;
  bottom:100%;
  left:0;right:0;
  height:16px;
  background:transparent;
}
.nav__dropdown-item {
  display:block;
  padding:9px 14px;
  font:500 13.5px var(--sans);
  color:var(--ink-700);
  border-radius:8px;
  white-space:nowrap;
  transition:background .12s,color .12s;
}
.nav__dropdown-item:hover,
.nav__dropdown-item.active {
  background:var(--sage-50);
  color:var(--forest-800);
  font-weight:700;
}

.nav__drop-wrap:hover .nav__dropdown {
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  transform:translateX(-50%) translateY(0);
  transition:opacity .12s 0s, visibility .12s 0s, transform .12s 0s;
}
.nav__drop-wrap:hover .nav__caret { transform:rotate(180deg) }

.nav__drawer-group { padding:6px 0 2px;margin:4px 0 }
.nav__drawer-group-label {
  font:700 11px var(--sans);
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--fern-600);
  padding:8px 4px 6px;
}
.nav__link--sub {
  padding-left:18px !important;
  font-size:16px !important;
  color:var(--ink-700) !important;
}
.nav__link--sub.active { color:var(--forest-800) !important; font-weight:700 !important }
</style>

<script>
  const burger = document.getElementById('nav-burger')!;
  const drawer = document.getElementById('nav-drawer')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  burger.addEventListener('click', () => {
    const open = drawer.classList.toggle('open');
    iconMenu.style.display = open ? 'none' : '';
    iconClose.style.display = open ? '' : 'none';
    document.body.style.overflow = open ? 'hidden' : '';
  });

  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    drawer.classList.remove('open');
    iconMenu.style.display = '';
    iconClose.style.display = 'none';
    document.body.style.overflow = '';
  }));

  // Set sks_lang cookie when user manually switches language
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href') || '';
      const lang = href.startsWith('/zh') ? 'zh' : 'en';
      document.cookie = `sks_lang=${lang}; path=/; max-age=31536000`;
    });
  });
</script>
